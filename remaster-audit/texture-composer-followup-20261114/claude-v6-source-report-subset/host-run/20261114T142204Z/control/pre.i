        s->total_ms = s_pf_buf_total[rd];
        s->present_wall_ms = s_pf_buf_pwall[rd];
        s->scene_gpu_ms = (double)sc / 1.0e6;
        s->present_gpu_ms = (double)pr / 1.0e6;
