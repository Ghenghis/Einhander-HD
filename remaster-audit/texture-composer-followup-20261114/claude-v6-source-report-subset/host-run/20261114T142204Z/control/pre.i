    if (psx_sdl_gl_make_current(win, s_ctx) != 0) { fprintf((__acrt_iob_func(1)), "psxrecomp: MakeCurrent failed (%s)\n", SDL_GetError()); SDL_GL_DestroyContext(s_ctx); s_ctx=((void*)0); return 0; }
    if (psx_sdl_gl_set_swap_interval(s_swap_interval) != 0 && s_swap_interval < 0) {
        psx_sdl_gl_set_swap_interval(1);
        s_swap_interval = 1;
