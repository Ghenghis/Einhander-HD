    } else {
        const size_t rgba_bytes = (size_t)w * (size_t)h * 4u, raw_bytes = (size_t)w * (size_t)h * 2u;
        const uint64_t s0 = (led ? SDL_GetPerformanceCounter() : 0);
        for (int r = 0; r < h; r++)
            memcpy(s_nu_raw_tight + (size_t)r * (size_t)w, raw + (size_t)r * (size_t)raw_stride, (size_t)w * 2u);
        const uint64_t s1 = (led ? SDL_GetPerformanceCounter() : 0);
        p_glBindBuffer(0x88EC, s_nu_pbo);
        const uint64_t s2 = (led ? SDL_GetPerformanceCounter() : 0);
        p_glBufferData(0x88EC, (ptrdiff_t)(rgba_bytes + raw_bytes), ((void*)0), 0x88E0);
        p_glBufferSubData_nu(0x88EC, 0, (ptrdiff_t)rgba_bytes, rgba);
        p_glBufferSubData_nu(0x88EC, (ptrdiff_t)rgba_bytes, (ptrdiff_t)raw_bytes, s_nu_raw_tight);
        const uint64_t s3 = (led ? SDL_GetPerformanceCounter() : 0);
        glBindTexture(0x0DE1, rgba_tex);
        const uint64_t s4 = (led ? SDL_GetPerformanceCounter() : 0);
        glTexSubImage2D(0x0DE1, 0, x, y, w, h, 0x1908, 0x1401, (const void *)0);
        const uint64_t s5 = (led ? SDL_GetPerformanceCounter() : 0);
        glBindTexture(0x0DE1, raw_tex);
        if (w & 1) glPixelStorei(0x0CF5, 2);
        const uint64_t s6 = (led ? SDL_GetPerformanceCounter() : 0);
        glTexSubImage2D(0x0DE1, 0, x, y, w, h, 0x8D94, 0x1403,
                        (const void *)(uintptr_t)rgba_bytes);
        const uint64_t s7 = (led ? SDL_GetPerformanceCounter() : 0);
        if (w & 1) glPixelStorei(0x0CF5, 4);
        p_glBindBuffer(0x88EC, 0);
        const uint64_t s8 = (led ? SDL_GetPerformanceCounter() : 0);
