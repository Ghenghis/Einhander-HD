        const char *path = getenv("PSXRECOMP_HD_PROOF_LOG");
        initialized = 1;
        if (path && *path) log = fopen(path, "ab");
    }
    if (!log || nseen >= sizeof seen / sizeof seen[0]) return;
    unsigned i;
    for (i = 0; i < nseen; ++i)
        if (seen[i].th == m->texture_hash && seen[i].ph == m->palette_hash &&
            seen[i].semi == semi && seen[i].replacement == (px != ((void*)0))) return;
    seen[nseen].th=m->texture_hash; seen[nseen].ph=m->palette_hash;
    seen[nseen].semi=semi; seen[nseen++].replacement=(px != ((void*)0));
    const HdSkinConfig *material=hd_skin_for_draw(m->texture_hash,m->palette_hash);
    const unsigned native_width=m->upload_width_words*(q->depth==0?4u:q->depth==1?2u:1u);
    const HdSkinDetailTexture *detail=hd_skin_detail_for_draw(material,m->texture_hash,m->palette_hash,
        native_width,m->upload_height,m->upload_serial);
    fprintf(log,"{\"key\":\"%08X-%08X\",\"frame\":%llu,"
            "\"replacement_size\":[%u,%u],\"native_words\":[%u,%u],"
            "\"depth\":%u,\"semi\":%d,\"source_kind\":\"%s\",\"clut_xy\":[%u,%u],"
            "\"uv_bounds\":[%u,%u,%u,%u],\"xy\":[[%d,%d],[%d,%d],[%d,%d]],"
            "\"uv_vertices\":[[%d,%d],[%d,%d],[%d,%d]],"
            "\"event\":\"%s\",\"material_contract\":\"" "ein-material-v3" "\","
            "\"material_profile\":\"%s\",\"material_channel\":\"%s\","
            "\"material_applied\":%s,\"material_strength\":%.4f,"
            "\"detail_applied\":%s,\"detail_size\":[%d,%d],\"detail_strength\":%.4f,\"detail_scale\":%.4f}\n",
            m->texture_hash,m->palette_hash,(unsigned long long)s_frame_count,
            px ? px->width : 0,px ? px->height : 0,m->upload_width_words,m->upload_height,q->depth,
            semi,m->exact_region ? "exact_region" : m->upload_serial ? "upload" : "native_page",q->clut_x,q->clut_y,q->u_first,q->v_first,q->u_last,q->v_last,
            xs[0],ys[0],xs[1],ys[1],xs[2],ys[2],
            us[0],vs[0],us[1],vs[1],us[2],vs[2],
            px ? "replacement GL draw submitted" : "source draw query matched",
            material && material->enabled && material->profile ? material->profile->id : "stock",
            material==&s_hd_skin ? "player" : material==&s_hd_skin_enemy ? "enemy" : "stock",
            px && material && material->enabled && material->profile ? "true" : "false",
            material ? (double)material->strength : 0.0,
            px && detail ? "true":"false",detail?detail->width:0,detail?detail->height:0,
            detail?(double)detail->config.strength:0.0,detail?(double)detail->config.scale:0.0);
    fflush(log);
}
static int hd_proof_replacements_enabled(void) {
