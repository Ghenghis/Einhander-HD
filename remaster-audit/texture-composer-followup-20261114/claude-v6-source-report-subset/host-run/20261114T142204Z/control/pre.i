static const HdSkinConfig *hd_skin_for_draw(uint32_t texture, uint32_t palette) {
    if (hd_skin_key_matches(&s_hd_skin,texture,palette) &&
        (s_hd_skin.enabled || (s_hd_detail_player.texture && s_hd_detail_player.config.enabled))) return &s_hd_skin;
    if (hd_skin_key_matches(&s_hd_skin_enemy,texture,palette) &&
        (s_hd_skin_enemy.enabled || (s_hd_detail_enemy.texture && s_hd_detail_enemy.config.enabled))) return &s_hd_skin_enemy;
    return ((void*)0);
