static void apply_psx_blend(int mode) {
    glEnable(0x0BE2);
    p_glBlendEquationSeparate((mode & 3) == 2 ? 0x800B
                                              : 0x8006,
                              0x8006);
    switch (mode & 3) {
    case 0:
        p_glBlendColor(0.5f, 0.5f, 0.5f, 0.5f);
        p_glBlendFuncSeparate(0x8003, 0x8003, 1, 0);
        break;
    case 1:
    case 2:
        p_glBlendFuncSeparate(1, 1, 1, 0);
        break;
    case 3:
        p_glBlendColor(0.25f, 0.25f, 0.25f, 0.25f);
        p_glBlendFuncSeparate(0x8003, 1, 1, 0);
        break;
    }
}
