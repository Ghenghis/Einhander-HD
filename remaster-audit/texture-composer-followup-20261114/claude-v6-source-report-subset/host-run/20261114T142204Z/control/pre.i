    if (!img_w || !m.upload_height) { hd_texture_pixels_release(&px); return 0; }
    {
        int lo_u = q.u_first < q.u_last ? q.u_first : q.u_last;
        int hi_u = q.u_first < q.u_last ? q.u_last : q.u_first;
        int lo_v = q.v_first < q.v_last ? q.v_first : q.v_last;
        int hi_v = q.v_first < q.v_last ? q.v_last : q.v_first;
        if (q.u_first <= q.u_last) {
            wxs[nwx++] = page_x + lo_u / (int)ppw;
            wxs[nwx++] = page_x + hi_u / (int)ppw;
        } else {
            wxs[nwx++] = page_x + 0;
            wxs[nwx++] = page_x + hi_u / (int)ppw;
            wxs[nwx++] = page_x + lo_u / (int)ppw;
            wxs[nwx++] = page_x + 255 / (int)ppw;
        }
        if (q.v_first <= q.v_last) {
            wys[nwy++] = page_y + lo_v;
            wys[nwy++] = page_y + hi_v;
        } else {
            wys[nwy++] = page_y + 0;
            wys[nwy++] = page_y + 255;
            wys[nwy++] = page_y + lo_v;
            wys[nwy++] = page_y + hi_v;
        }
    }
    for (i = 0; i < nwx; i++) wxs[i] &= (1024 - 1);
    for (i = 0; i < nwy; i++) wys[i] &= (512 - 1);
