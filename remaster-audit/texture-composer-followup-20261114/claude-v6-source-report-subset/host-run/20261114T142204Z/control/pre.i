static size_t hd_gpu_base_budget(void) {
    static int initialized; static size_t budget;
    if (!initialized) {
        initialized=1; const char *v=getenv("PSXRECOMP_HD_GPU_CACHE_MB");
        if (v && *v>='0' && *v<='9') {
            char *end=((void*)0); unsigned long n=strtoul(v,&end,10);
            if (end && !*end && n>=256 && n<=8192) budget=(size_t)n*1024u*1024u;
        }
    }
    return budget;
}
static int hd_gpu_slot_limit(void) { return hd_gpu_base_budget()?1024:256; }
static size_t hd_gpu_base_bytes_except(int except) {
    size_t bytes=0;
    for(int i=0;i<hd_gpu_slot_limit();++i)
        if(i!=except && s_hd_tex[i].tex) bytes+=(size_t)s_hd_tex[i].w*s_hd_tex[i].h*4u;
    return bytes;
}
static void hd_tex_release_slot(HdTexSlot *slot);
static void hd_gpu_reserve_base(size_t incoming,int keep) {
    const size_t budget=hd_gpu_base_budget();
    if(!budget)return;
    size_t used=hd_gpu_base_bytes_except(keep);
    while(used>budget-incoming) {
        int oldest=-1; uint64_t stamp=0xffffffffffffffffULL;
        for(int i=0;i<hd_gpu_slot_limit();++i)
            if(i!=keep && s_hd_tex[i].tex && s_hd_tex[i].stamp<stamp) {oldest=i;stamp=s_hd_tex[i].stamp;}
        if(oldest<0)break;
        size_t bytes=(size_t)s_hd_tex[oldest].w*s_hd_tex[oldest].h*4u;
        hd_tex_release_slot(&s_hd_tex[oldest]); used-=bytes;
    }
}
unsigned gl_renderer_hd_gpu_cache_slots(void) {return (unsigned)hd_gpu_slot_limit();}
uint64_t gl_renderer_hd_gpu_cache_budget(void) {return (uint64_t)hd_gpu_base_budget();}
uint64_t gl_renderer_hd_gpu_cache_bytes(void) {return (uint64_t)hd_gpu_base_bytes_except(-1);}
