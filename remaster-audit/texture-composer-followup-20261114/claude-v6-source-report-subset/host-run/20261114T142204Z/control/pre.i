    GLuint fbo = 0;
    for (int i = 0; i < 4; i++)
        if (s_wide_fbo[i] && s_wide_base[i] == base_x) { fbo = s_wide_fbo[i]; break; }
    if (!fbo) return 0;
    flush_tex_batch();
    flush_cpu_upload();
    wide_blit_center(fbo, base_x, 0, 512);
    glFinish();
    int W = g_wide_w * s_scale;
    int H = 512 * s_scale;
    if (cap_pixels > 0 && (long)W * H > cap_pixels) { H = cap_pixels / W; if (H <= 0) return 0; }
    uint32_t *tmp = (uint32_t *)malloc((size_t)W * H * sizeof(uint32_t));
    if (!tmp) return 0;
    p_glBindFramebuffer(0x8CA8, fbo);
    glPixelStorei(0x0D05, 4);
    glReadPixels(0, 0, W, H, 0x80E1, 0x1401, tmp);
    p_glBindFramebuffer(0x8CA8, 0);
    int count = 0;
    for (int i = 0; i < W * H; i++) { out[i] = tmp[i] | 0xFF000000u; count++; }
    free(tmp);
    if (ow) *ow = W;
    if (oh) *oh = H;
    return count;
