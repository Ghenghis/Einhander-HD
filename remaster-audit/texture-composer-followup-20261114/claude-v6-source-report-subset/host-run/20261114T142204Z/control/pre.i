static void native_upload_rect(GLuint rgba_tex, GLuint raw_tex, int x, int y, int w, int h,
                               const uint32_t *rgba, const uint16_t *raw, int raw_stride,
                               int want_pbo, uint32_t flush_seq, int rect_index, int rects) {
    const int led = flush_seq != 0 && gl_renderer_native_upload_ledger_enabled();
    const uint64_t t0 = (led ? SDL_GetPerformanceCounter() : 0);
    uint64_t staging = 0, state = 0, rgba_up = 0, raw_up = 0;
    const int pbo = want_pbo && native_upload_pbo_ready();
    if (!pbo) {
        const uint64_t a = (led ? SDL_GetPerformanceCounter() : 0);
        glBindTexture(0x0DE1, rgba_tex);
        const uint64_t b = (led ? SDL_GetPerformanceCounter() : 0);
        glTexSubImage2D(0x0DE1, 0, x, y, w, h, 0x1908, 0x1401, rgba);
        const uint64_t c = (led ? SDL_GetPerformanceCounter() : 0);
        glBindTexture(0x0DE1, raw_tex);
        glPixelStorei(0x0CF2, raw_stride);
        const uint64_t d = (led ? SDL_GetPerformanceCounter() : 0);
        glTexSubImage2D(0x0DE1, 0, x, y, w, h, 0x8D94, 0x1403, raw);
        const uint64_t e = (led ? SDL_GetPerformanceCounter() : 0);
