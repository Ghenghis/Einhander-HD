static void hd_skin_detail_release(HdSkinDetailTexture *detail) {
    if (detail->texture) glDeleteTextures(1,&detail->texture);
    memset(detail,0,sizeof(*detail));
}
static void hd_skin_detail_load(HdSkinDetailTexture *detail, int enemy) {
    const HdSkinConfig *material=enemy?&s_hd_skin_enemy:&s_hd_skin;
    const char *prefix=enemy?"PSXRECOMP_SKIN_ENEMY_DETAIL_":"PSXRECOMP_SKIN_DETAIL_";
    char variable[96];
    const char *path,*strength,*scale;
    unsigned char *encoded=((void*)0),*rgba=((void*)0);
    long size;
    int width=0,height=0,channels=0,status;
    FILE *file;
    memset(detail,0,sizeof(*detail));
    snprintf(variable,sizeof variable,"%sPATH",prefix); path=getenv(variable);
    snprintf(variable,sizeof variable,"%sSTRENGTH",prefix); strength=getenv(variable);
    snprintf(variable,sizeof variable,"%sSCALE",prefix); scale=getenv(variable);
    status=hd_skin_detail_parse(&detail->config,path,strength,scale);
    if (status<0) {
        fprintf((__acrt_iob_func(2)),"[skin_detail] invalid %s detail configuration; layer disabled\n",enemy?"enemy":"player");
        return;
    }
    if (!status || !material->valid || !material->key_count) return;
    file=fopen(detail->config.path,"rb");
    if (!file) { fprintf((__acrt_iob_func(2)),"[skin_detail] %s PNG unavailable; layer disabled\n",enemy?"enemy":"player"); return; }
    if (fseek(file,0,2)!=0 || (size=ftell(file))<8 ||
        (unsigned long)size>(64u * 1024u * 1024u) || fseek(file,0,0)!=0) {
        fclose(file); fprintf((__acrt_iob_func(2)),"[skin_detail] PNG exceeds encoded-size bounds or cannot be read\n"); return;
    }
    encoded=(unsigned char*)malloc((size_t)size);
    if (!encoded || fread(encoded,1,(size_t)size,file)!=(size_t)size) {
        free(encoded); fclose(file); fprintf((__acrt_iob_func(2)),"[skin_detail] PNG read failed; layer disabled\n"); return;
    }
    fclose(file);
    if (!hd_skin_detail_png_preflight(encoded,(size_t)size,&width,&height,&channels,stbi_zlib_decode_buffer) ||
        !hd_skin_detail_dimensions_valid(width,height,(size_t)size)) {
        free(encoded); fprintf((__acrt_iob_func(2)),"[skin_detail] bounded PNG preflight failed (requires 8-bit RGB/RGBA, noninterlaced, <=4096x4096)\n"); return;
    }
    {
        GLint maximum=0; glGetIntegerv(0x0D33,&maximum);
        if (width>maximum || height>maximum) { free(encoded); fprintf((__acrt_iob_func(2)),"[skin_detail] PNG exceeds GPU texture limits\n"); return; }
    }
    rgba=stbi_load_from_memory(encoded,(int)size,&width,&height,&channels,4);
    free(encoded);
    if (!rgba) { fprintf((__acrt_iob_func(2)),"[skin_detail] PNG decode failed; layer disabled\n"); return; }
    p_glActiveTexture(0x84C0 +1);
    glGenTextures(1,&detail->texture);
    glBindTexture(0x0DE1,detail->texture);
    glTexParameteri(0x0DE1,0x2802,0x8370);
    glTexParameteri(0x0DE1,0x2803,0x8370);
    glTexParameteri(0x0DE1,0x2801,0x2703);
    glTexParameteri(0x0DE1,0x2800,0x2601);
    glPixelStorei(0x0CF2,0);
    glTexImage2D(0x0DE1,0,0x8058,width,height,0,0x1908,0x1401,rgba);
    p_glGenerateMipmap(0x0DE1);
    stbi_image_free(rgba);
    if (glGetError()!=0) {
        glDeleteTextures(1,&detail->texture); detail->texture=0;
        fprintf((__acrt_iob_func(2)),"[skin_detail] GPU upload failed; layer disabled\n");
    } else {
        detail->width=width; detail->height=height;
        fprintf((__acrt_iob_func(2)),"[skin_detail] %s authored RGB layer uploaded %dx%d, strength %.3f, scale %.3f; original alpha/STP retained\n",
            enemy?"enemy":"player",width,height,(double)detail->config.strength,(double)detail->config.scale);
    }
    p_glActiveTexture(0x84C0);
}
static const HdSkinDetailTexture *hd_skin_detail_for_draw(const HdSkinConfig *material,
