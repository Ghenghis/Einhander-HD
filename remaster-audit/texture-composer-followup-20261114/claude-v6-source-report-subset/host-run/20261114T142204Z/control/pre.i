static void hd_track_upload(int x, int y, int w, int h, const uint16_t *d) {
    if (hd_page_enabled() || hd_texture_pack_region_count(s_hd_pack)) hd_page_changed(&s_hd_pages,x,y,w,h,0);
    hd_ensure_pack();
    if (!s_hd_pack || !d || w <= 0 || h <= 0) return;
    uint32_t source_hash = 0;
    if (hd_texture_pack_track_upload(s_hd_pack,
                                 (uint16_t)(x & (1024 - 1)),
                                 (uint16_t)(y & (512 - 1)),
                                 (uint16_t)w, (uint16_t)h,
                                 d, (size_t)w * (size_t)h, &source_hash))
        hd_source_upload_store(source_hash,(unsigned)w,(unsigned)h,d);
}
static void hd_invalidate(int x, int y, int w, int h) {
    if (hd_page_enabled() || hd_texture_pack_region_count(s_hd_pack)) hd_page_changed(&s_hd_pages,x,y,w,h,1);
    if (s_hd_state <= 0 || !s_hd_pack || w <= 0 || h <= 0) return;
    hd_texture_pack_invalidate(s_hd_pack,
                               (uint16_t)(x & (1024 - 1)),
                               (uint16_t)(y & (512 - 1)),
                               (uint16_t)w, (uint16_t)h);
}
static void hd_word_rgb(uint16_t px, uint8_t *r, uint8_t *g, uint8_t *b) {
    *r = (uint8_t)((px & 0x1F) << 3);
    *g = (uint8_t)(((px >> 5) & 0x1F) << 3);
    *b = (uint8_t)(((px >> 10) & 0x1F) << 3);
}
static inline uint8_t hd_word_alpha(uint16_t px) {
    if (px == 0) return 0;
    return (px & 0x8000) ? 255 : 127;
}
static void hd_dump_source_sidecars(const HdTextureDrawQuery *q,
                                    const HdTextureSourceMatch *m,
                                    const HdTextureUploadFragment *frags,
                                    size_t frag_count, const uint16_t *clut) {
    static int enabled = -1;
    if (enabled < 0) {
        const char *value = getenv("PSXRECOMP_HD_SOURCE_SIDECARS");
        enabled = value && strcmp(value, "1") == 0;
    }
    if (!enabled) return;
    const size_t count = (size_t)m->upload_width_words * m->upload_height;
    uint16_t *words = (uint16_t *)calloc(count, sizeof(uint16_t));
    uint8_t *valid = (uint8_t *)calloc(count, 1);
    uint8_t *bytes = (uint8_t *)malloc(count * 2);
    if (!words || !valid || !bytes) {
        free(words); free(valid); free(bytes); return;
    }
    size_t fi, known = 0;
    for (fi = 0; fi < frag_count; ++fi) {
        const HdTextureUploadFragment *fr = &frags[fi];
        unsigned row, col;
        for (row = 0; row < fr->height; ++row) {
            for (col = 0; col < fr->width; ++col) {
                const unsigned ux = fr->source_x + col, uy = fr->source_y + row;
                if (ux >= m->upload_width_words || uy >= m->upload_height) continue;
                size_t dest = (size_t)uy * m->upload_width_words + ux;
                words[dest] = s_vram[((fr->y + row) & (512 - 1)) * 1024 +
                                    ((fr->x + col) & (1024 - 1))];
                if (!valid[dest]) { valid[dest] = 1; ++known; }
            }
        }
    }
    const uint16_t *original = hd_source_upload_find(m);
    if (original) {
        memcpy(words,original,count*sizeof(uint16_t));
        memset(valid,1,count); known=count;
    }
    size_t i;
    for (i = 0; i < count; ++i) {
        bytes[i*2] = (uint8_t)words[i]; bytes[i*2+1] = (uint8_t)(words[i] >> 8);
    }
    char base[1200], path[1250];
    snprintf(base, sizeof base, "%s/%08X-%08X", s_hd_dump_dir,
             m->texture_hash, m->palette_hash);
    snprintf(path, sizeof path, "%s.words.bin", base);
    FILE *f = fopen(path, "wb");
    if (f) { fwrite(bytes, 2, count, f); fclose(f); }
    snprintf(path, sizeof path, "%s.valid.bin", base);
    f = fopen(path, "wb");
    if (f) { fwrite(valid, 1, count, f); fclose(f); }
    unsigned nclut = q->depth == HD_TEXTURE_DEPTH_4BPP ? 16u :
                     q->depth == HD_TEXTURE_DEPTH_8BPP ? 256u : 0u;
    uint8_t palette_bytes[512];
    for (i = 0; i < nclut; ++i) {
        palette_bytes[i*2] = (uint8_t)clut[i];
        palette_bytes[i*2+1] = (uint8_t)(clut[i] >> 8);
    }
    snprintf(path, sizeof path, "%s.clut.bin", base);
    f = fopen(path, "wb");
    if (f) { fwrite(palette_bytes, 2, nclut, f); fclose(f); }
    snprintf(path, sizeof path, "%s.source.json", base);
    f = fopen(path, "wb");
    if (f) {
        fprintf(f, "{\"key\":\"%08X-%08X\",\"frame\":%llu,"
                "\"upload_serial\":%llu,\"width_words\":%u,\"height\":%u,"
                "\"depth\":%u,\"clut_xy\":[%u,%u],\"clut_words\":%u,"
                "\"known_words\":%llu,\"total_words\":%llu,"
                "\"reconstructed_crc32\":\"%08X\",\"raw_origin\":\"%s\",\"fragments\":[",
                m->texture_hash,m->palette_hash,(unsigned long long)s_frame_count,
                (unsigned long long)m->upload_serial,m->upload_width_words,m->upload_height,
                q->depth,q->clut_x,q->clut_y,nclut,
                (unsigned long long)known,(unsigned long long)count,
                hd_texture_crc32_words_le(words,count),
                m->exact_region ? "validated manifested exact source region" : !m->upload_serial ? "draw-referenced native texture page" :
                original ? "original CPU upload" : "surviving VRAM fragments");
        for (fi = 0; fi < frag_count; ++fi) {
            const HdTextureUploadFragment *fr = &frags[fi];
            fprintf(f,"%s[%u,%u,%u,%u,%u,%u]",fi ? "," : "",
                    fr->x,fr->y,fr->width,fr->height,fr->source_x,fr->source_y);
        }
        fprintf(f,"]}\n"); fclose(f);
    }
    free(words); free(valid); free(bytes);
}
static int hdr_source_key_compare(const void *a,const void *b){
 const GlResearchSourceKey *x=(const GlResearchSourceKey*)a,*y=(const GlResearchSourceKey*)b;
 if(x->texture!=y->texture)return x->texture<y->texture?-1:1;
 return x->palette==y->palette?0:(x->palette<y->palette?-1:1);
}
static int hdr_source_filter_valid(const GlResearchLimits *limits){
 unsigned i,j;if(!limits||limits->source_policy>GL_RESEARCH_SOURCE_EXCLUDE||limits->source_key_count>256)return 0;
 if((limits->source_policy==GL_RESEARCH_SOURCE_ALL)!=(limits->source_key_count==0))return 0;
 for(i=0;i<limits->source_key_count;++i)for(j=0;j<i;++j)if(!hdr_source_key_compare(&limits->source_keys[i],&limits->source_keys[j]))return 0;
 return 1;
}
static uint32_t hdr_source_filter_hash(const GlResearchLimits *limits){
 uint32_t value=2166136261u;unsigned i,j;char key[19];
 for(i=0;i<limits->source_key_count;++i){snprintf(key,sizeof key,"%08X-%08X\n",limits->source_keys[i].texture,limits->source_keys[i].palette);for(j=0;j<18;++j)value=(value^(unsigned char)key[j])*16777619u;}
 return value;
}
static int hdr_source_filter_selected(const GlResearchLimits *limits,uint32_t texture,uint32_t palette){
 GlResearchSourceKey key;int found;
 if(limits->source_policy==GL_RESEARCH_SOURCE_ALL)return 1;
 key.texture=texture;key.palette=palette;
 found=bsearch(&key,limits->source_keys,limits->source_key_count,sizeof key,hdr_source_key_compare)!=((void*)0);
 return limits->source_policy==GL_RESEARCH_SOURCE_INCLUDE?found:!found;
}
static const char *hdr_source_policy_name(unsigned policy){return policy==GL_RESEARCH_SOURCE_INCLUDE?"include":policy==GL_RESEARCH_SOURCE_EXCLUDE?"exclude":"all";}
