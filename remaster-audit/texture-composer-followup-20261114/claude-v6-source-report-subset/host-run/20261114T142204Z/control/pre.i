            int visible[4];const int width=1024-page_x;
            if(hd_visible_uv_limits(xs,ys,us,vs,area,lim,visible)>0 &&
               visible[0]>=0 && visible[0]<width && visible[2]<=width){
                q.u_first=(uint8_t)visible[0];
                q.u_last=(uint8_t)(visible[2]<width?visible[2]:width-1);
                q.v_first=(uint8_t)visible[1];q.v_last=(uint8_t)visible[3];
                page_w=hd_page_admission_width(page_x,depth,q.u_first,q.u_last,0);
                if(page_w)native_edge_width=width;
            }
        }
        if(!page_w)return 0;
        int x0=xs[0],x1=xs[0],y0=ys[0],y1=ys[0];
        for (int v=1;v<3;++v) {
            if(xs[v]<x0)x0=xs[v]; if(xs[v]>x1)x1=xs[v];
            if(ys[v]<y0)y0=ys[v]; if(ys[v]>y1)y1=ys[v];
        }
        if(s_pc_valid){++x1;++y1;}
