    if (s_mq_ok)
        for (int i = 0; i < 4; i++) {
            p_glGenQueries(1024 * 2, s_mq_q[i]);
            s_mq_n[i] = 0; s_mq_over[i] = 0;
        }
    s_mq_open = 0;
    s_pf_freq = SDL_GetPerformanceFrequency();
    if (!s_pf_freq) s_pf_freq = 1;
    s_pf_b = 0; s_pf_scene_active = 0; s_pf_count = 0; s_pf_ring_seq = 0;
    s_pf_last_enter = 0;
