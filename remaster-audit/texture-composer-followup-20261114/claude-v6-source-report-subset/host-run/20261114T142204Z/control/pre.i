        const uint32_t *src = tmp + (size_t)row * W;
        uint32_t *dst = (uint32_t *)((uint8_t *)out + (size_t)row * pitch);
        for (int col = 0; col < W; col++) { dst[col] = src[col] | 0xFF000000u; count++; }
