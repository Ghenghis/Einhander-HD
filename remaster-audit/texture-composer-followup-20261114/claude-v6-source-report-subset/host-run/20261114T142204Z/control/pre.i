static uint64_t s_hd_dumped_set[16384u];
static uint64_t hd_dumped_key(uint32_t tex, uint32_t pal) {
    uint64_t key = ((uint64_t)tex << 32) | pal;
    return key == 0ull ? ~0ull : key;
}
static int hd_dumped_lookup(uint32_t tex, uint32_t pal) {
    uint64_t key = hd_dumped_key(tex, pal);
    unsigned idx = (unsigned)(key * 0x9E3779B97F4A7C15ull >>
                    (64 - 14)) & (16384u - 1);
    unsigned i;
    for (i = 0; i < 16384u; i++) {
        uint64_t v = s_hd_dumped_set[(idx + i) & (16384u - 1)];
        if (v == key) return 1;
        if (v == 0ull) return 0;
    }
    return 0;
}
static void hd_dumped_mark(uint32_t tex, uint32_t pal) {
    uint64_t key = hd_dumped_key(tex, pal);
    unsigned idx = (unsigned)(key * 0x9E3779B97F4A7C15ull >>
                    (64 - 14)) & (16384u - 1);
    unsigned i;
    for (i = 0; i < 16384u; i++) {
        uint64_t *slot = &s_hd_dumped_set[(idx + i) & (16384u - 1)];
        if (*slot == key) return;
        if (*slot == 0ull) { *slot = key; return; }
    }
}
static void hd_dump_upload(const HdTextureDrawQuery *q,
                           const HdTextureSourceMatch *m) {
    char path[1200];
    if (hd_dumped_lookup(m->texture_hash, m->palette_hash))
        return;
    snprintf(path, sizeof path, "%s/%08X-%08X.png",
             s_hd_dump_dir, m->texture_hash, m->palette_hash);
    FILE *probe = fopen(path, "rb");
    if (probe) {
        fclose(probe);
        hd_dumped_mark(m->texture_hash, m->palette_hash);
        return;
    }
    size_t frag_count = 0;
    if (m->upload_serial && (hd_texture_pack_upload_fragments(s_hd_pack, m->upload_serial,
                                         ((void*)0), 0, &frag_count)
            != HD_TEXTURE_LOOKUP_FOUND || frag_count == 0 || frag_count > 4096))
        return;
    if (!m->upload_serial) frag_count = 1;
    HdTextureUploadFragment *frags =
        (HdTextureUploadFragment *)malloc(frag_count * sizeof *frags);
    if (!frags) return;
    if (m->upload_serial)
        hd_texture_pack_upload_fragments(s_hd_pack, m->upload_serial,
                                         frags, frag_count, &frag_count);
    else {
        memset(frags,0,sizeof *frags);
        frags->x=m->exact_region?m->region_x:q->page_x; frags->y=m->exact_region?m->region_y:q->page_y;
        frags->width=m->upload_width_words; frags->height=m->upload_height;
    }
    const unsigned ppw = q->depth == HD_TEXTURE_DEPTH_4BPP ? 4u :
                         q->depth == HD_TEXTURE_DEPTH_8BPP ? 2u : 1u;
    const unsigned img_w = (unsigned)m->upload_width_words * ppw;
    const unsigned img_h = m->upload_height;
    if (!img_w || !img_h || (uint64_t)img_w * img_h > 16ull * 1024 * 1024) {
        free(frags); return;
    }
    uint8_t *rgba = (uint8_t *)malloc((size_t)img_w * img_h * 4);
    if (!rgba) { free(frags); return; }
    uint16_t clut[256] = {0};
    if (q->depth != HD_TEXTURE_DEPTH_16BPP) {
        const unsigned n = q->depth == HD_TEXTURE_DEPTH_4BPP ? 16u : 256u;
        const unsigned cy = q->clut_y & (512 - 1);
        unsigned i;
        for (i = 0; i < n; i++)
            clut[i] = s_vram[cy * 1024 + ((q->clut_x + i) & (1024 - 1))];
    }
    memset(rgba, 0, (size_t)img_w * img_h * 4);
    {
        size_t fi;
        for (fi = 0; fi < frag_count; fi++) {
            const HdTextureUploadFragment *fr = &frags[fi];
            unsigned row, col;
            for (row = 0; row < fr->height; row++) {
                for (col = 0; col < fr->width; col++) {
                    const uint16_t w =
                        s_vram[((fr->y + row) & (512 - 1)) * 1024 +
                               ((fr->x + col) & (1024 - 1))];
                    const unsigned px_base_x = (fr->source_x + col) * ppw;
                    const unsigned px_y = fr->source_y + row;
                    unsigned p;
                    for (p = 0; p < ppw; p++) {
                        uint16_t px = w;
                        uint8_t *out;
                        if (q->depth == HD_TEXTURE_DEPTH_4BPP)
                            px = clut[(w >> (p * 4)) & 0xF];
                        else if (q->depth == HD_TEXTURE_DEPTH_8BPP)
                            px = clut[(w >> (p * 8)) & 0xFF];
                        out = rgba + ((size_t)px_y * img_w + px_base_x + p) * 4;
                        hd_word_rgb(px, out, out + 1, out + 2);
                        out[3] = hd_word_alpha(px);
                    }
                }
            }
        }
    }
    {
        const uint16_t *original = m->upload_serial ? hd_source_upload_find(m) : ((void*)0);
        if (original) {
            size_t wi;
            for (wi = 0; wi < (size_t)m->upload_width_words * img_h; ++wi) {
                unsigned p;
                for (p = 0; p < ppw; ++p) {
                    uint16_t px = original[wi];
                    if (q->depth == HD_TEXTURE_DEPTH_4BPP) px=clut[(px>>(p*4))&15];
                    else if (q->depth == HD_TEXTURE_DEPTH_8BPP) px=clut[(px>>(p*8))&255];
                    uint8_t *out=rgba+(wi*ppw+p)*4;
                    hd_word_rgb(px,out,out+1,out+2); out[3]=hd_word_alpha(px);
                }
            }
        }
        FILE *f = fopen(path, "wb");
        if (f) {
            if (png_write_rgba(f, rgba, img_w, img_h)) {
                fprintf((__acrt_iob_func(2)), "[hd_tex] dumped %s (%ux%u)\n",
                        path, img_w, img_h);
                hd_dump_source_sidecars(q, m, frags, frag_count, clut);
                hd_dumped_mark(m->texture_hash, m->palette_hash);
            }
            fclose(f);
        }
    }
    free(rgba);
    free(frags);
}
