            ev->total_ticks = SDL_GetPerformanceCounter() - ledger_fn0;
            s_hd_upload_seq++;
        }
        s->stamp = ++s_hd_stamp;
        return s->tex;
    }
}
static void hd_draw_passes(int semi, int mask, int nverts) {
    int bsemi = (semi < 0) ? -1 : ((!s_mask_check && semi != 2) ? 4 : semi);
    p_glUniform1i(s_hd_uSemimode, bsemi < 0 ? 0 : bsemi);
    if (bsemi < 0) {
        glDisable(0x0BE2);
        mask_stencil(mask);
        p_glUniform1i(s_hd_uSemipass, 0);
        glDrawArrays(0x0004, 0, nverts);
        if (s_mask_check) {
            glColorMask(0, 0, 0, 0);
            mask_stencil(1);
            p_glUniform1i(s_hd_uSemipass, 2);
            glDrawArrays(0x0004, 0, nverts);
            glColorMask(1, 1, 1, 1);
        } else if (!mask) {
            s_stencil_valid = 0;
        }
    } else if (bsemi == 4) {
        glEnable(0x0BE2);
        p_glBlendEquationSeparate(0x8006, 0x8006);
        p_glBlendFuncSeparate(1, 0x8589, 1, 0);
        if (mask) mask_stencil(1); else glDisable(0x0B90);
        p_glUniform1i(s_hd_uSemipass, 0);
        glDrawArrays(0x0004, 0, nverts);
        if (!mask) s_stencil_valid = 0;
    } else {
        glDisable(0x0BE2);
        mask_stencil(mask);
        p_glUniform1i(s_hd_uSemipass, 1);
        glDrawArrays(0x0004, 0, nverts);
        apply_psx_blend(semi);
        mask_stencil(1);
        p_glUniform1i(s_hd_uSemipass, 2);
        glDrawArrays(0x0004, 0, nverts);
    }
}
static void flush_hd_batch(void) {
    unsigned n=s_hd_batch_n;
    if(!n)return;
    s_hd_batch_n=0;
    const int diag=hd_cpu_diag_enabled();
    const uint64_t started=diag?SDL_GetPerformanceCounter():0;
    p_glBindVertexArray(s_tex_vao);
    p_glBindBuffer(0x8892,s_tex_vbo);
    p_glBufferData(0x8892,(ptrdiff_t)(n*3*22*sizeof(float)),s_hd_batch_vertices,0x88E0);
    hd_draw_passes(-1,s_hd_batch_key.mask,(int)n*3);
    for(unsigned i=0;i<n;++i){
        HdOpaqueReceipt *r=&s_hd_batch_receipts[i];HdTexturePixels px={0};
        px.width=r->width;px.height=r->height;
        hd_proof_draw_receipt(&r->source,&r->query,&px,-1,r->xs,r->ys,r->us,r->vs);
        ++s_hd_proof_counts[4];++s_hd_proof_counts[r->source.upload_serial?9:8];
    }
    hr_end();
    if(diag){
        s_hd_cpu_diag.submitted+=n;
        const uint64_t ticks=SDL_GetPerformanceCounter()-started;
        s_hd_cpu_diag.draw_ticks+=ticks;
        if(!s_hd_cpu_prim_active)s_hd_cpu_diag.total_ticks+=ticks;
        ++s_hd_cpu_diag.batch_flushes;s_hd_cpu_diag.batched_primitives+=n;
        if(n>s_hd_cpu_diag.max_batch_primitives)s_hd_cpu_diag.max_batch_primitives=n;
    }
}
static int hd_frag_contains(const HdTextureUploadFragment *fr, int wx, int wy) {
    int dx = (wx - (int)fr->x) & (1024 - 1);
    int dy = (wy - (int)fr->y) & (512 - 1);
    return dx < (int)fr->width && dy < (int)fr->height;
}
static void hd_rearm_pending_destination(int x0,int y0,int x1,int y1) {
    if(x0>x1||y0>y1)return;
    rect_add(&s_pack_dirty,x0,y0,x1,y1);
    hd_invalidate(x0,y0,x1-x0+1,y1-y0+1);
    if(!s_cpu_auth_dual)s_gpu_dirty=1;
}
static int hd_on_textured_prim_impl(const int *xs, const int *ys,
                               const int *us, const int *vs,
                               const float *col, uint16_t texpage,
                               uint16_t clut_x, uint16_t clut_y,
                               int rawtex, int semi, const int *lim,
                               int depth) {
    hr_close_leaked_keep();
    HdTextureDrawQuery q;
    HdTextureSourceMatch m;
    HdTexturePixels px;
    GLuint resident_tex = 0;
    unsigned ppw, img_w;
    int page_x, page_y;
    int wxs[4], wys[4], nwx = 0, nwy = 0;
    int i, j, covered = 0;
    const HdTextureUploadFragment *frag = ((void*)0);
    HdTextureUploadFragment *frags = ((void*)0);
    size_t frag_count = 0;
    int off_x, off_y;
    int native_edge_width=0;
    hd_ensure_pack();
    if (s_hd_state <= 0 || !s_hd_pack || !s_vram || !s_hd_prog) return 0;
    s_hd_proof_counts[0]++;
    hd_proof_stats_tick();
    page_x = (texpage & 0xF) * 64;
    page_y = ((texpage >> 4) & 1) * 256;
    memset(&q, 0, sizeof q);
    q.page_x = (uint16_t)page_x;
    q.page_y = (uint16_t)page_y;
    q.depth = (uint8_t)depth;
    q.u_first = (uint8_t)(lim[0] & 255);
    q.u_last = (uint8_t)(lim[2] & 255);
    q.v_first = (uint8_t)(lim[1] & 255);
    q.v_last = (uint8_t)(lim[3] & 255);
    q.clut_x = clut_x;
    q.clut_y = clut_y;
    q.vram = s_vram;
    q.vram_word_count = (size_t)1024 * 512;
    const int cpu_diag=hd_cpu_diag_enabled();
    const uint64_t source_start=cpu_diag?SDL_GetPerformanceCounter():0;
    const int upload_status=hd_texture_pack_match_source(s_hd_pack,&q,&m);
    if(cpu_diag){++s_hd_cpu_diag.source_queries;s_hd_cpu_diag.source_ticks+=SDL_GetPerformanceCounter()-source_start;}
    if(upload_status==HD_TEXTURE_LOOKUP_AMBIGUOUS || upload_status==HD_TEXTURE_LOOKUP_ERROR)return 0;
    if(player_draw_only()){
        if(upload_status==HD_TEXTURE_LOOKUP_FOUND)player_draw_on_source(&m,&q,xs,ys);
        return 0;
    }
    if(upload_status!=HD_TEXTURE_LOOKUP_FOUND){
        HdTextureRegionCandidate region;
        const int region_status=hd_texture_pack_probe_region(s_hd_pack,&q,&region);
        if(region_status==HD_TEXTURE_LOOKUP_AMBIGUOUS)return 0;
        if(region_status==HD_TEXTURE_LOOKUP_FOUND){
            if((s_tw_mask_x|s_tw_mask_y)!=0)return 0;
            int x0=xs[0],x1=xs[0],y0=ys[0],y1=ys[0];
            for(int v=1;v<3;++v){if(xs[v]<x0)x0=xs[v];if(xs[v]>x1)x1=xs[v];if(ys[v]<y0)y0=ys[v];if(ys[v]>y1)y1=ys[v];}
            if(s_pc_valid){++x1;++y1;}
            if(x0<s_area_x1)x0=s_area_x1;if(x1>s_area_x2)x1=s_area_x2;
            if(y0<s_area_y1)y0=s_area_y1;if(y1>s_area_y2)y1=s_area_y2;
            const int rppw=4>>depth;
            const int sx0=page_x+q.u_first/rppw,sx1=page_x+q.u_last/rppw;
            const int sy0=page_y+q.v_first,sy1=page_y+q.v_last;
            if(x0<=sx1&&x1>=sx0&&y0<=sy1&&y1>=sy0)return 0;
            if(depth<2 && y0<=q.clut_y&&y1>=q.clut_y && x0<q.clut_x+(depth?256:16)&&x1>=q.clut_x)return 0;
            if(hd_page_needs_cpu(&s_hd_pages,region.x,region.y,region.width_words,region.height)||
               (depth<2&&hd_page_needs_cpu(&s_hd_pages,q.clut_x,q.clut_y,depth?256:16,1))){
                if(!s_raster_ok || glGetError()!=0)return 0;
