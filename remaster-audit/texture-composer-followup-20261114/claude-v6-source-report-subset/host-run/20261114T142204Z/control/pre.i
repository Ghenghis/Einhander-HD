        s_nu_tot.rgba_upload_ticks += rgba_up; s_nu_tot.raw_upload_ticks += raw_up;
        s_nu_tot.total_ticks += total;
        if (total > s_nu_tot.max_total_ticks) {
            s_nu_tot.max_total_ticks = total;
            s_nu_tot.max_total_frame = (uint32_t)s_frame_count;
        }
        if (total > s_nu_slow_threshold) {
            GlNativeUploadEvent *e = &s_nu_ring[s_nu_slow_seq % 2048];
            memset(e, 0, sizeof *e);
            e->frame = (uint32_t)s_frame_count; e->flush_seq = flush_seq;
            e->x = (uint16_t)x; e->y = (uint16_t)y; e->w = (uint16_t)w; e->h = (uint16_t)h;
            e->rect_index = (uint16_t)rect_index; e->rects_in_flush = (uint16_t)rects; e->mode = mode;
            e->staging_ticks = staging; e->state_ticks = state;
