    if (x + w > 1024) { w1 = 1024 - x; w2 = w - w1; }
    if (y + h > 512) { h1 = 512 - y; h2 = h - h1; }
    up_add(x, y, x + w1 - 1, y + h1 - 1);
    if (w2) up_add(0, y, w2 - 1, y + h1 - 1);
