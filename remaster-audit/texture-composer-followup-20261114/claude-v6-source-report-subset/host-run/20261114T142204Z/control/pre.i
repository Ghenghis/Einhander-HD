    out->greif_first_frame=s->first;out->greif_last_frame=s->last;
    out->greif_age_frames=s->seen&&frame>=s->last?frame-s->last:0xffffffffffffffffULL;
    out->greif_valid=enabled&&s->seen&&out->greif_age_frames<=12;
