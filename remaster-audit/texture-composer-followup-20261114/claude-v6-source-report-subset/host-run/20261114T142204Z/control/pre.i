static int glb_render_display_hires(uint32_t *out, int pitch,
                                    int dx, int dy, int dw, int dh) {
    const int direct = s_raster_ok && s_ctx && s_hr_fbo &&
                       !gpu_display_is_depth24();
    const int scale = direct ? s_scale : 1;
    if (!out || dw <= 0 || dh <= 0 || dw > 1024 || dh > 512 ||
        scale < 1 || scale > 16 || pitch < dw * scale * 4)
        return 0;
    if (!direct) {
        if (s_raster_ok && s_ctx && !gpu_display_is_depth24()) ensure_cpu();
        return sw_render_display_hires(out, pitch, dx, dy, dw, dh);
    }
    const int width = dw * scale, height = dh * scale;
    uint32_t *pixels = (uint32_t *)malloc((size_t)width * height * sizeof(*pixels));
    if (!pixels) return 0;
    GLint prior_fbo = 0, prior_alignment = 0, prior_row_length = 0;
    GLint prior_skip_rows = 0, prior_skip_pixels = 0, prior_read_buffer = 0;
    glGetIntegerv(0x8CAA, &prior_fbo);
    glGetIntegerv(0x0D05, &prior_alignment);
    glGetIntegerv(0x0D02, &prior_row_length);
    glGetIntegerv(0x0D03, &prior_skip_rows);
    glGetIntegerv(0x0D04, &prior_skip_pixels);
    flush_flat_batch();
    flush_tex_batch();
    flush_cpu_upload();
    p_glBindFramebuffer(0x8CA8, s_hr_fbo);
    glGetIntegerv(0x0C02, &prior_read_buffer);
    glReadBuffer(0x8CE0);
    glPixelStorei(0x0D05, 4);
    glPixelStorei(0x0D02, width);
    glPixelStorei(0x0D03, 0);
    glPixelStorei(0x0D04, 0);
    const int start_x = ((dx % 1024) + 1024) % 1024;
    const int start_y = ((dy % 512) + 512) % 512;
    for (int oy = 0; oy < height;) {
        const int sy = (start_y * scale + oy) % (512 * scale);
        int rows = 512 * scale - sy;
        if (rows > height - oy) rows = height - oy;
        for (int ox = 0; ox < width;) {
            const int sx = (start_x * scale + ox) % (1024 * scale);
            int columns = 1024 * scale - sx;
            if (columns > width - ox) columns = width - ox;
            glReadPixels(sx, sy, columns, rows, 0x80E1, 0x1401,
                         pixels + (size_t)oy * width + ox);
            ox += columns;
        }
        oy += rows;
    }
    glReadBuffer((GLenum)prior_read_buffer);
    p_glBindFramebuffer(0x8CA8, (GLuint)prior_fbo);
    glPixelStorei(0x0D05, prior_alignment);
    glPixelStorei(0x0D02, prior_row_length);
    glPixelStorei(0x0D03, prior_skip_rows);
    glPixelStorei(0x0D04, prior_skip_pixels);
    for (int row = 0; row < height; ++row) {
        uint8_t *destination = (uint8_t *)out + (size_t)row * pitch;
        for (int col = 0; col < width; ++col) {
            const uint32_t pixel = pixels[(size_t)row * width + col] | 0xFF000000u;
            memcpy(destination + (size_t)col * sizeof(pixel), &pixel, sizeof(pixel));
        }
    }
    free(pixels);
    return width * height;
}
static int depth24_is_fb_transfer(int x, int y, int w, int h) {
    if (!gpu_display_is_depth24() || w <= 0 || h <= 0) return 0;
    GpuDisplayInfo di;
    gpu_get_display_info(&di);
    int fb_w = (int)((di.width * 3u + 1u) / 2u);
    int fb_h = (int)di.height;
    if (fb_w < 8) fb_w = 8;
    if (fb_h < 1) fb_h = 1;
    if (w <= 256 && h <= 256) return 0;
    {
        int dx = (int)(di.display_x & 1023u);
        int dy = (int)(di.display_y & 511u);
        int x0 = x & (1024 - 1), y0 = y & (512 - 1);
        if (x0 + w <= dx || x0 >= dx + fb_w || y0 + h <= dy || y0 >= dy + fb_h)
            return 0;
    }
    if (h >= fb_h - 8 && h <= fb_h + 16 && w >= (fb_w * 3) / 4) return 1;
    if ((int64_t)w * (int64_t)h >= ((int64_t)fb_w * fb_h) / 2) return 1;
    return 0;
}
static void depth24_mark_scanout_band(void) {
    GpuDisplayInfo di;
    int fb_w, fb_h, x0, y0, x1, y1;
    if (!gpu_display_is_depth24()) return;
    gpu_get_display_info(&di);
    fb_w = (int)((di.width * 3u + 1u) / 2u);
    fb_h = (int)di.height;
    if (fb_w < 8) fb_w = 8;
    if (fb_h < 1) fb_h = 1;
    x0 = (int)(di.display_x & 1023u);
    y0 = (int)(di.display_y & 511u);
    x1 = x0 + fb_w - 1;
    y1 = y0 + fb_h - 1;
    if (x1 > 1024 - 1) x1 = 1024 - 1;
    if (y1 > 512 - 1) y1 = 512 - 1;
    rect_add(&s_d24_skip_fb, x0, y0, x1, y1);
}
static void depth24_clear_skipped_fb(void) {
    if (!s_raster_ok || !s_d24_skip_fb.set) return;
    flush_flat_batch();
    flush_tex_batch();
    int x0 = s_d24_skip_fb.x0, y0 = s_d24_skip_fb.y0;
    int x1 = s_d24_skip_fb.x1, y1 = s_d24_skip_fb.y1;
    int rw = x1 - x0 + 1, rh = y1 - y0 + 1;
    int S = s_scale;
    p_glBindFramebuffer(0x8D40, s_hr_fbo);
    glDisable(0x0BE2);
    glDisable(0x0B90);
    glEnable(0x0C11);
    glViewport(0, 0, 1024 * S, 512 * S);
    glScissor(x0 * S, y0 * S, rw * S, rh * S);
    glClearColor(0.f, 0.f, 0.f, 0.f);
    glClearStencil(0);
    glStencilMask(0xFF);
    glClear(0x00004000 | 0x00000400);
    if (s_raw_fbo) {
        p_glBindFramebuffer(0x8D40, s_raw_fbo);
        glViewport(0, 0, 1024, 512);
        glScissor(x0, y0, rw, rh);
        glClear(0x00004000);
    }
    glDisable(0x0C11);
    p_glBindFramebuffer(0x8D40, 0);
    rect_add(&s_pack_dirty, x0, y0, x1, y1);
    present_dirty_rect(x0, y0, x1, y1, 1);
    rect_clear(&s_d24_skip_fb);
}
static void depth24_upload_policy(void) {
    int d24 = gpu_display_is_depth24();
    if (d24 && !s_depth24_skip_up) {
        ensure_cpu();
        s_up_nrects = 0;
        rect_clear(&s_d24_skip_fb);
    } else if (!d24 && s_depth24_skip_up) {
        s_up_nrects = 0;
        depth24_clear_skipped_fb();
        gpu_depth24_upload_span_reset();
        gl_renderer_invalidate_present();
    }
    s_depth24_skip_up = d24;
}
static void glb_vram_write(int x,int y,uint16_t px){
    sw_vram_write(x,y,px);
    hd_invalidate(x, y, 1, 1);
    depth24_upload_policy();
    up_add(x & (1024 -1), y & (512 -1), x & (1024 -1), y & (512 -1));
}
static uint16_t glb_vram_read(int x,int y){ ensure_cpu(); return sw_vram_read(x,y); }
static void glb_vram_transfer_in(int x,int y,int w,int h,const uint16_t *d){
    sw_vram_transfer_in(x,y,w,h,d);
    depth24_upload_policy();
    if (s_depth24_skip_up && depth24_is_fb_transfer(x, y, w, h)) {
        hd_invalidate(x, y, w, h);
        if (w >= 1024 && h >= 512) {
            up_add_transfer(x, y, w, h);
            rect_clear(&s_d24_skip_fb);
            depth24_mark_scanout_band();
            coh_record(GL_COH_UPLOAD, x, y, x + w - 1, y + h - 1);
            return;
        }
        depth24_mark_scanout_band();
        coh_record(GL_COH_UPLOAD, x, y, x+w-1, y+h-1);
        return;
    }
    if (w >= 1024 && h >= 512)
        hd_invalidate(x, y, w, h);
    else
        hd_track_upload(x, y, w, h, d);
    up_add_transfer(x, y, w, h);
    coh_record(GL_COH_UPLOAD, x, y, x+w-1, y+h-1);
}
static void glb_vram_transfer_out(int x,int y,int w,int h,uint16_t *d){ ensure_cpu(); sw_vram_transfer_out(x,y,w,h,d); }
static void upload_present_tex(const uint32_t *pixels, int w, int h, int linear) {
    glBindTexture(0x0DE1, s_present_tex);
    glTexParameteri(0x0DE1, 0x2801, linear ? 0x2601 : 0x2600);
    glTexParameteri(0x0DE1, 0x2800, linear ? 0x2601 : 0x2600);
    glTexParameteri(0x0DE1, 0x2802, 0x812F);
    glTexParameteri(0x0DE1, 0x2803, 0x812F);
    if (w != s_present_w || h != s_present_h) {
        glTexImage2D(0x0DE1, 0, 0x1908, w, h, 0, 0x80E1, 0x1401, pixels);
        s_present_w = w; s_present_h = h;
    } else {
        glTexSubImage2D(0x0DE1, 0, 0, 0, w, h, 0x80E1, 0x1401, pixels);
    }
}
static int s_fmv_filter_cfg = 0;
void gl_renderer_set_fmv_filter(int cfg_value) {
    if (cfg_value >= 0 && cfg_value <= 4) s_fmv_filter_cfg = cfg_value;
}
static int s_post_degrain = 0;
void gl_renderer_set_post_degrain(int on) { s_post_degrain = on ? 1 : 0; }
