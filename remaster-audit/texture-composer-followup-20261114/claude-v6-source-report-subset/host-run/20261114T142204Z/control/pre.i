    if (!detail || !detail->texture || !detail->config.enabled || !upload_serial ||
        !hd_skin_detail_source_bounds(material,texture,palette,width,height)) return ((void*)0);
    return detail;
}
static int s_hd_cfg_enable = 0;
static char s_hd_cfg_root[1024];
static char s_hd_cfg_dump[1024];
static size_t s_hd_decode_budget = (size_t)256 * 1024 * 1024;
void gpu_hd_texture_config(int enabled, const char *root, const char *dump) {
    s_hd_cfg_enable = enabled ? 1 : -1;
    snprintf(s_hd_cfg_root, sizeof s_hd_cfg_root, "%s", root ? root : "");
    snprintf(s_hd_cfg_dump, sizeof s_hd_cfg_dump, "%s", dump ? dump : "");
}
static void hd_ensure_pack(void) {
    if (s_hd_state != 0) return;
    s_hd_state = -1;
    if (s_hd_cfg_enable < 0) return;
    const char *root = s_hd_cfg_root[0] ? s_hd_cfg_root
                                        : getenv("PSXRECOMP_HD_TEXTURE_ROOT");
    const char *dump = s_hd_cfg_dump[0] ? s_hd_cfg_dump
                                        : getenv("PSXRECOMP_HD_DUMP");
    if (s_hd_cfg_enable > 0 && (!root || !root[0]) && (!dump || !dump[0]))
        dump = "hd_dump";
    if ((!root || !root[0]) && (!dump || !dump[0])) return;
    const char *pack_root = (root && root[0]) ? root : dump;
    char err[256] = {0};
    if (dump && dump[0]) {
        snprintf(s_hd_dump_dir, sizeof s_hd_dump_dir, "%s", dump);
        if (!root || !root[0]) {
            char sub[1200], ini[1200];
            snprintf(sub, sizeof sub,
                     "%s/einhander-texture-replacements", dump);
            snprintf(ini, sizeof ini, "%s/Hashes.ini", dump);
            _mkdir(dump);
            _mkdir(sub);
            FILE *f = fopen(ini, "ab");
            if (f) fclose(f);
            snprintf(s_hd_dump_dir, sizeof s_hd_dump_dir, "%s", sub);
        }
        s_hd_dump = 1;
    }
    if (hd_texture_pack_create(pack_root, &s_hd_pack, err, sizeof err) &&
        s_hd_pack) {
        const char *budget = getenv("PSXRECOMP_HD_DECODE_BUDGET_MB");
        if (budget && *budget) {
            char *end = ((void*)0);
            unsigned long mb = strtoul(budget, &end, 10);
            if (end && !*end && mb >= 32 && mb <= 2048)
                s_hd_decode_budget = (size_t)mb * 1024 * 1024;
        }
        hd_texture_pack_set_decode_budget(s_hd_pack, s_hd_decode_budget);
        hd_texture_pack_set_cost_profile(s_hd_pack, hd_cpu_diag_enabled());
        s_hd_state = 1;
        fprintf((__acrt_iob_func(2)), "[hd_tex] pack active: %s%s\n", pack_root,
                s_hd_dump ? " (dumping)" : "");
    } else {
        fprintf((__acrt_iob_func(2)), "[hd_tex] pack unavailable: %s\n",
                err[0] ? err : "create failed");
        s_hd_pack = ((void*)0);
        s_hd_dump = 0;
    }
}
typedef struct {
    unsigned count;
    int valid, filtered;
    uint32_t hashes[32];
} HdSourceCacheFilter;
static int hd_source_cache_filter_parse(const char *text,HdSourceCacheFilter *out) {
    HdSourceCacheFilter next;memset(&next,0,sizeof next);next.valid=1;
    if(!text || !*text){*out=next;return 1;}
    next.filtered=1;
    for(;;){
        uint32_t hash=0;
        if(next.count==32)goto invalid;
        for(unsigned i=0;i<8;++i){
            unsigned char c=(unsigned char)*text;
            unsigned value;
            if(c>='0' && c<='9')value=c-'0';
            else if(c>='a' && c<='f')value=c-'a'+10;
            else if(c>='A' && c<='F')value=c-'A'+10;
            else goto invalid;
            hash=(hash<<4)|value;++text;
        }
        next.hashes[next.count++]=hash;
        if(!*text){*out=next;return 1;}
        if(*text++!=',' || !*text)goto invalid;
    }
invalid:
    memset(out,0,sizeof *out);out->filtered=1;return 0;
}
static int hd_source_cache_filter_match(const HdSourceCacheFilter *filter,uint32_t hash) {
    if(!filter->valid)return 0;
    if(!filter->filtered)return 1;
    for(unsigned i=0;i<filter->count;++i)if(filter->hashes[i]==hash)return 1;
    return 0;
}
static HdSourceCacheFilter s_hd_source_filter;
static int s_hd_source_filter_ready;
static int hd_source_cache_admits(uint32_t hash) {
    if(!s_hd_source_filter_ready){
        if(!hd_source_cache_filter_parse(getenv("PSXRECOMP_HD_SOURCE_CACHE_KEYS"),&s_hd_source_filter))
            fprintf((__acrt_iob_func(2)),"[hd_tex] invalid source-cache CRC shortlist; upload copies refused\n");
        s_hd_source_filter_ready=1;
    }
    return hd_source_cache_filter_match(&s_hd_source_filter,hash);
}
typedef struct {
    uint32_t hash;
    unsigned w, h;
    uint16_t *words;
    size_t bytes;
    uint64_t stamp;
} HdSourceUpload;
static HdSourceUpload s_hd_sources[256];
static size_t s_hd_source_bytes = 0;
static uint64_t s_hd_source_stamp = 0;
static int hd_source_capture_enabled(void) {
    static int enabled = -1;
    if (s_hd_research.active) return 1;
    if (enabled < 0) {
        const char *value = getenv("PSXRECOMP_HD_SOURCE_SIDECARS");
        enabled = value && strcmp(value,"1") == 0;
    }
    return enabled;
}
static void hd_source_upload_store(uint32_t hash, unsigned w, unsigned h,
                                   const uint16_t *words) {
    if (!hd_source_capture_enabled()) return;
    if (!hd_source_cache_admits(hash)) return;
    const size_t bytes = (size_t)w * h * sizeof(uint16_t);
    if (!bytes || bytes > (32u * 1024u * 1024u)) return;
    unsigned i, slot = 256;
    for (i = 0; i < 256; ++i) {
        HdSourceUpload *item = &s_hd_sources[i];
        if (item->words && item->hash == hash && item->w == w && item->h == h) {
            item->stamp = ++s_hd_source_stamp; return;
        }
        if (!item->words && slot == 256) slot = i;
    }
    while (s_hd_source_bytes + bytes > (32u * 1024u * 1024u) || slot == 256) {
        unsigned oldest = 256;
        for (i = 0; i < 256; ++i)
            if (s_hd_sources[i].words && (oldest == 256 ||
                s_hd_sources[i].stamp < s_hd_sources[oldest].stamp)) oldest = i;
        if (oldest == 256) return;
        s_hd_source_bytes -= s_hd_sources[oldest].bytes;
        free(s_hd_sources[oldest].words);
        memset(&s_hd_sources[oldest],0,sizeof s_hd_sources[oldest]);
        slot = oldest;
    }
    uint16_t *copy = (uint16_t *)malloc(bytes);
    if (!copy) return;
    memcpy(copy,words,bytes);
    s_hd_sources[slot].hash=hash; s_hd_sources[slot].w=w; s_hd_sources[slot].h=h;
    s_hd_sources[slot].words=copy; s_hd_sources[slot].bytes=bytes;
    s_hd_sources[slot].stamp=++s_hd_source_stamp;
    s_hd_source_bytes += bytes;
}
static const uint16_t *hd_source_upload_find(const HdTextureSourceMatch *m) {
    if (!hd_source_capture_enabled()) return ((void*)0);
    unsigned i;
    for (i = 0; i < 256; ++i) {
        HdSourceUpload *item = &s_hd_sources[i];
        if (item->words && item->hash == m->texture_hash &&
            item->w == m->upload_width_words && item->h == m->upload_height) {
            item->stamp=++s_hd_source_stamp; return item->words;
        }
    }
    return ((void*)0);
}
static HdNativePageCache s_hd_pages;
static int hd_page_enabled(void) {
    static int enabled = -1;
    if (enabled < 0) {
        const char *value = getenv("PSXRECOMP_HD_PAGE_FALLBACK");
        enabled = value && strcmp(value,"1") == 0;
    }
    return enabled;
