        if(!s_hd_batch_n){
        if(native_edge_width){hr_close_kept();pack_flush();}
        hr_begin(1);
        p_glUseProgram(s_hd_prog);
        if(s_hd_attrib_gate!=attrib){p_glUniform1i(s_hd_uAttrib,attrib);s_hd_attrib_gate=attrib;}
