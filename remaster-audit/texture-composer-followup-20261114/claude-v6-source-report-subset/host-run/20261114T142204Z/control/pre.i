        glBindTexture(0x0DE1,s_raw_tex);
        p_glActiveTexture(0x84C0);
        const HdSkinConfig *material=hd_skin_for_draw(m.texture_hash,m.palette_hash);
        p_glUniform1i(s_hd_uSkinEnabled,material && material->enabled && material->profile);
        p_glUniform1i(s_hd_uSkinPreserveAccents,material && material->preserve_accents);
        if (material && material->enabled && material->profile) {
            float primary[3],accent[3];
            hd_skin_color_components(material->profile->primary_rgb,primary);
            hd_skin_color_components(material->profile->accent_rgb,accent);
            p_glUniform3f(s_hd_uSkinPrimary,primary[0],primary[1],primary[2]);
            p_glUniform3f(s_hd_uSkinAccent,accent[0],accent[1],accent[2]);
            p_glUniform1f(s_hd_uSkinStrength,material->strength);
        }
        const HdSkinDetailTexture *detail=hd_skin_detail_for_draw(material,m.texture_hash,m.palette_hash,
            img_w,m.upload_height,m.upload_serial);
        p_glUniform1i(s_hd_uDetailEnabled,detail!=((void*)0));
        if (detail) {
            p_glActiveTexture(0x84C0 +1);
            glBindTexture(0x0DE1,detail->texture);
            p_glUniform1f(s_hd_uDetailStrength,detail->config.strength);
            p_glUniform1f(s_hd_uDetailScale,detail->config.scale);
            p_glActiveTexture(0x84C0);
        }
        p_glUniform1i(s_hd_uMaskset, s_mask_set);
        p_glUniform2f(s_hd_uOff, (float)off_x, (float)off_y);
        p_glUniform2f(s_hd_uDim, (float)img_w, (float)m.upload_height);
        }
        if(batch){
            unsigned index=s_hd_batch_n;HdOpaqueReceipt *r=&s_hd_batch_receipts[index];
            if(!index){s_hd_batch_key=key;s_hd_batch_key_full=full;}
            memcpy(s_hd_batch_vertices+index*3*22,verts,sizeof(verts));
            r->source=m;r->query=q;r->width=px.width;r->height=px.height;
            memcpy(r->xs,xs,sizeof(r->xs));memcpy(r->ys,ys,sizeof(r->ys));
            memcpy(r->us,us,sizeof(r->us));memcpy(r->vs,vs,sizeof(r->vs));
            ++s_hd_batch_n;
        }else{
        p_glBindVertexArray(s_tex_vao);
        p_glBindBuffer(0x8892, s_tex_vbo);
        p_glBufferData(0x8892,
                       (ptrdiff_t)(3 * 22 * sizeof(float)),
                       verts, 0x88E0);
        hd_draw_passes(semi, s_mask_set,3);
        hd_proof_draw_receipt(&m, &q, &px, semi, xs, ys, us, vs);
        s_hd_proof_counts[4]++;
        s_hd_proof_counts[m.upload_serial ? 9 : 8]++;
        hr_end();
        if(cpu_diag)++s_hd_cpu_diag.submitted;
        }
        if(cpu_diag)s_hd_cpu_diag.draw_ticks+=SDL_GetPerformanceCounter()-draw_start;
    }
    hd_texture_pixels_release(&px);
    return 1;
}
static int hd_on_textured_prim(const int *xs,const int *ys,const int *us,const int *vs,
        const float *col,uint16_t texpage,uint16_t clut_x,uint16_t clut_y,
        int rawtex,int semi,const int *lim,int depth) {
    const int diag=hd_cpu_diag_enabled();
    const uint64_t start=diag?SDL_GetPerformanceCounter():0;
    if(diag)++s_hd_cpu_prim_active;
    int drawn=hd_on_textured_prim_impl(xs,ys,us,vs,col,texpage,clut_x,clut_y,rawtex,semi,lim,depth);
    if(diag)--s_hd_cpu_prim_active;
    if(diag){++s_hd_cpu_diag.attempts;s_hd_cpu_diag.total_ticks+=SDL_GetPerformanceCounter()-start;}
    return drawn;
}
static void gpu_copy_rect(int sx,int sy,int dx,int dy,int w,int h) {
    if (w <= 0 || h <= 0) return;
    flush_flat_batch();
    flush_tex_batch();
    flush_cpu_upload();
    if (sx < 0) sx = 0; if (sy < 0) sy = 0;
    if (dx < 0) dx = 0; if (dy < 0) dy = 0;
    if (sx + w > 1024) w = 1024 - sx;
    if (dx + w > 1024) w = 1024 - dx;
    if (sy + h > 512) h = 512 - sy;
    if (dy + h > 512) h = 512 - dy;
    if (w <= 0 || h <= 0) return;
    int S = s_scale;
    p_glBindFramebuffer(0x8CA8, s_hr_fbo);
    p_glBindFramebuffer(0x8CA9, s_scratch_fbo);
    glDisable(0x0C11);
    p_glBlitFramebuffer(sx*S, sy*S, (sx+w)*S, (sy+h)*S,
                        sx*S, sy*S, (sx+w)*S, (sy+h)*S,
                        0x00004000, 0x2600);
    p_glBindFramebuffer(0x8CA8, 0);
    p_glBindFramebuffer(0x8CA9, 0);
    hr_begin(0);
    glScissor(dx*S, dy*S, w*S, h*S);
    glDisable(0x0BE2);
    p_glUseProgram(s_blit_prog);
    p_glActiveTexture(0x84C0);
    glBindTexture(0x0DE1, s_scratch_tex);
    p_glUniform1i(s_uBlitSrc, 0);
    p_glUniform1i(s_uBlitMaskset, s_mask_set);
    p_glUniform1i(s_uBlitSrcDiv, 1);
    p_glUniform2i(s_uBlitSrcOff, (sx - dx) * S, (sy - dy) * S);
    float fx0 = (float)dx, fy0 = (float)dy, fx1 = (float)(dx + w), fy1 = (float)(dy + h);
    float verts[6 * 2] = {
        fx0, fy0, fx1, fy0, fx0, fy1,
        fx1, fy0, fx0, fy1, fx1, fy1,
    };
    p_glBindVertexArray(s_blit_vao);
    p_glBindBuffer(0x8892, s_blit_vbo);
    p_glBufferData(0x8892, sizeof verts, verts, 0x88E0);
    mask_stencil(s_mask_set); p_glUniform1i(s_uBlitPass, 1); glDrawArrays(0x0004, 0, 6);
    mask_stencil(1); p_glUniform1i(s_uBlitPass, 2); glDrawArrays(0x0004, 0, 6);
    hr_end();
    rect_add(&s_pack_dirty, dx, dy, dx + w - 1, dy + h - 1);
    if (!s_cpu_auth_dual)
        s_gpu_dirty = 1;
    coh_record(GL_COH_COPY_SRC, sx, sy, sx + w - 1, sy + h - 1);
    coh_record(GL_COH_COPY, dx, dy, dx + w - 1, dy + h - 1);
    if (s_hd_state > 0 && s_hd_pack && s_vram && !player_draw_only()) {
        uint16_t *copied = (uint16_t *)malloc((size_t)w * h * sizeof(uint16_t));
        if (copied) {
            int row;
            ensure_cpu();
            for (row = 0; row < h; ++row)
                memcpy(copied + (size_t)row * w,
                       s_vram + (size_t)(dy + row) * 1024 + dx,
                       (size_t)w * sizeof(uint16_t));
            hd_track_upload(dx, dy, w, h, copied);
            free(copied);
        } else {
            hd_invalidate(dx, dy, w, h);
        }
    } else {
        hd_invalidate(dx, dy, w, h);
    }
}
