static void present_set_sharp(int mode, int tex_w, int tex_h,
                              int out_w, int out_h) {
    if (s_present_uSharp < 0) return;
    if (mode <= 0 || tex_w <= 0 || tex_h <= 0) {
        p_glUniform1i(s_present_uSharp, 0);
        return;
    }
    p_glUniform1i(s_present_uSharp, mode);
    if (s_present_uTexSize >= 0)
        p_glUniform2f(s_present_uTexSize, (float)tex_w, (float)tex_h);
    if (s_present_uSharpScale >= 0)
        p_glUniform2f(s_present_uSharpScale,
                      (float)out_w / (float)tex_w,
                      (float)out_h / (float)tex_h);
}
static int s_aspect_num = 4, s_aspect_den = 3;
void gl_renderer_set_display_aspect(int num, int den) {
    if (num <= 0 || den <= 0) { num = 4; den = 3; }
    s_aspect_num = num; s_aspect_den = den;
}
static void letterbox_rect_aspect(int ww, int wh, int num, int den,
                                  int *x, int *y, int *w, int *h) {
    int dw = ww, dh = (ww * den) / num;
    if (dh > wh) { dh = wh; dw = (wh * num) / den; }
    *x = (ww - dw) / 2;
    *y = (wh - dh) / 2;
    *w = dw; *h = dh;
}
static void letterbox_rect(int ww, int wh, int *x, int *y, int *w, int *h) {
    letterbox_rect_aspect(ww, wh, s_aspect_num, s_aspect_den, x, y, w, h);
}
static GLuint make_tex(GLenum internal, int w, int h, GLenum fmt, GLenum type) {
    GLuint t = 0;
    glGenTextures(1, &t);
    glBindTexture(0x0DE1, t);
    glTexParameteri(0x0DE1, 0x2801, 0x2600);
    glTexParameteri(0x0DE1, 0x2800, 0x2600);
    glTexParameteri(0x0DE1, 0x2802, 0x812F);
    glTexParameteri(0x0DE1, 0x2803, 0x812F);
    glTexImage2D(0x0DE1, 0, (GLint)internal, w, h, 0, fmt, type, ((void*)0));
    return t;
}
int gl_renderer_native_upload_selftest(char *out, size_t cap) {
    enum { TW = 64, TH = 32, SS = 80, NCASE = 8 };
    static const int cases[NCASE][4] = {
        {3, 2, 7, 5}, {0, 0, 1, 1}, {TW - 1, TH - 1, 1, 1}, {0, 10, TW, 1},
        {10, 12, 9, 9}, {14, 16, 9, 9}, {TW - 5, 3, 5, TH - 3}, {31, 0, 1, TH}};
    static uint16_t bg[TW * TH], model[TW * TH], src[SS * TH], rb_raw_off[TW * TH], rb_raw_on[TW * TH];
    static uint32_t bg_rgba[TW * TH], conv[TW * TH], rb_rgba_off[TW * TH], rb_rgba_on[TW * TH];
    static uint8_t written[TW * TH];
    if (!out || cap < 128) return 0;
    if (!s_raster_ok || !s_ctx) { snprintf(out, cap, "\"ok\":false,\"error\":\"renderer not ready\""); return 0; }
    flush_flat_batch(); flush_tex_batch(); flush_hd_batch();
    int pre_errors = 0;
    GLenum last_pre = 0, ge;
    while (pre_errors < 16 && (ge = glGetError()) != 0) { last_pre = ge; pre_errors++; }
    const GLenum sticky = glGetError();
    if (sticky != 0) {
        snprintf(out, cap, "\"ok\":false,\"error\":\"GL error queue did not clear before the self-test\","
                 "\"preexisting_errors\":%d,\"last_preexisting\":%u,\"sticky_error\":%u,\"state_changed\":false",
                 pre_errors, (unsigned)last_pre, (unsigned)sticky);
        return 0;
    }
    GLint act = 0, tex0 = 0, unpack_buf = 0, pack_buf = 0, ua = 4, url = 0, pa = 4, prl = 0;
    glGetIntegerv(0x84E0, &act);
    p_glActiveTexture(0x84C0);
    glGetIntegerv(0x8069, &tex0);
    glGetIntegerv(0x88EF, &unpack_buf);
    glGetIntegerv(0x88ED, &pack_buf);
    glGetIntegerv(0x0CF5, &ua); glGetIntegerv(0x0CF2, &url);
    glGetIntegerv(0x0D05, &pa); glGetIntegerv(0x0D02, &prl);
    p_glBindBuffer(0x88EC, 0); p_glBindBuffer(0x88EB, 0);
    glPixelStorei(0x0CF5, 4); glPixelStorei(0x0CF2, 0);
    uint32_t lcg = 0x1234567u;
    for (int i = 0; i < TW * TH; i++) {
        lcg = lcg * 1664525u + 1013904223u;
        bg[i] = (uint16_t)(lcg >> 16); bg_rgba[i] = conv_1555_to_rgba8(bg[i]); model[i] = bg[i]; written[i] = 0;
    }
    for (int i = 0; i < SS * TH; i++) { lcg = lcg * 1664525u + 1013904223u; src[i] = (uint16_t)(lcg >> 8); }
    src[0] = 0x0000; src[1] = 0x7FFF; src[2] = 0x8000; src[3] = 0xFFFF; src[SS + 5] = 0x8000; src[2 * SS + 6] = 0xFFFF;
    GLuint t[4];
    for (int k = 0; k < 4; k++) {
        t[k] = (k & 1) ? make_tex(0x8234, TW, TH, 0x8D94, 0x1403)
                       : make_tex(0x8058, TW, TH, 0x1908, 0x1401);
        glBindTexture(0x0DE1, t[k]);
        if (k & 1) glTexSubImage2D(0x0DE1, 0, 0, 0, TW, TH, 0x8D94, 0x1403, bg);
        else glTexSubImage2D(0x0DE1, 0, 0, 0, TW, TH, 0x1908, 0x1401, bg_rgba);
    }
    for (int c = 0; c < NCASE; c++) {
        const int x = cases[c][0], y = cases[c][1], w = cases[c][2], h = cases[c][3];
        const int sx = (c * 3) % (SS - w + 1), sy = (c * 5) % (TH - h + 1);
        const uint16_t *rs = src + (size_t)sy * SS + sx;
        for (int r = 0; r < h; r++)
            for (int q = 0; q < w; q++) {
                conv[(size_t)r * w + q] = conv_1555_to_rgba8(rs[(size_t)r * SS + q]);
                model[(size_t)(y + r) * TW + x + q] = rs[(size_t)r * SS + q];
                written[(size_t)(y + r) * TW + x + q] = 1;
            }
        native_upload_rect(t[0], t[1], x, y, w, h, conv, rs, SS, 0, 0, c, NCASE);
        native_upload_rect(t[2], t[3], x, y, w, h, conv, rs, SS, 1, 0, c, NCASE);
    }
    const int pbo_ready = s_nu_pbo_state > 0;
    glPixelStorei(0x0D05, 1); glPixelStorei(0x0D02, 0);
    glBindTexture(0x0DE1, t[0]); glGetTexImage(0x0DE1, 0, 0x1908, 0x1401, rb_rgba_off);
    glBindTexture(0x0DE1, t[1]); glGetTexImage(0x0DE1, 0, 0x8D94, 0x1403, rb_raw_off);
    glBindTexture(0x0DE1, t[2]); glGetTexImage(0x0DE1, 0, 0x1908, 0x1401, rb_rgba_on);
    glBindTexture(0x0DE1, t[3]); glGetTexImage(0x0DE1, 0, 0x8D94, 0x1403, rb_raw_on);
    const GLenum err_test = glGetError();
    int onoff_rgba = 0, onoff_raw = 0, off_rgba = 0, off_raw = 0, on_rgba = 0, on_raw = 0, holes = 0, first = -1;
    for (int i = 0; i < TW * TH; i++) {
        const uint32_t mr = conv_1555_to_rgba8(model[i]);
        int bad = 0;
        if (rb_rgba_on[i] != rb_rgba_off[i]) { onoff_rgba++; bad = 1; }
        if (rb_raw_on[i] != rb_raw_off[i]) { onoff_raw++; bad = 1; }
        if (rb_rgba_off[i] != mr) { off_rgba++; bad = 1; }
        if (rb_raw_off[i] != model[i]) { off_raw++; bad = 1; }
        if (rb_rgba_on[i] != mr) { on_rgba++; bad = 1; }
        if (rb_raw_on[i] != model[i]) { on_raw++; bad = 1; }
        if (!written[i] && (rb_raw_on[i] != bg[i] || rb_raw_off[i] != bg[i] ||
                            rb_rgba_on[i] != bg_rgba[i] || rb_rgba_off[i] != bg_rgba[i])) { holes++; bad = 1; }
        if (bad && first < 0) first = i;
    }
    glDeleteTextures(4, t);
    glBindTexture(0x0DE1, (GLuint)tex0);
    GLint q_tex0 = -1, q_act = -1, q_unpack = -1, q_pack = -1, q_ua = -1, q_url = -1, q_pa = -1, q_prl = -1;
    glGetIntegerv(0x8069, &q_tex0);
    p_glActiveTexture((GLenum)act);
    p_glBindBuffer(0x88EC, (GLuint)unpack_buf);
    p_glBindBuffer(0x88EB, (GLuint)pack_buf);
    glPixelStorei(0x0CF5, ua); glPixelStorei(0x0CF2, url);
    glPixelStorei(0x0D05, pa); glPixelStorei(0x0D02, prl);
    glGetIntegerv(0x84E0, &q_act);
    glGetIntegerv(0x88EF, &q_unpack);
    glGetIntegerv(0x88ED, &q_pack);
    glGetIntegerv(0x0CF5, &q_ua); glGetIntegerv(0x0CF2, &q_url);
    glGetIntegerv(0x0D05, &q_pa); glGetIntegerv(0x0D02, &q_prl);
    const GLenum err_restore = glGetError();
    const unsigned restore_mismatch =
        (q_tex0 != tex0 ? 1u : 0u) | (q_act != act ? 2u : 0u) | (q_unpack != unpack_buf ? 4u : 0u) |
        (q_pack != pack_buf ? 8u : 0u) | (q_ua != ua ? 16u : 0u) | (q_url != url ? 32u : 0u) |
        (q_pa != pa ? 64u : 0u) | (q_prl != prl ? 128u : 0u);
    const int state_restored = restore_mismatch == 0 && err_restore == 0;
    const int mismatches = onoff_rgba + onoff_raw + off_rgba + off_raw + on_rgba + on_raw + holes;
    const int ok = err_test == 0 && mismatches == 0 && state_restored;
    snprintf(out, cap,
             "\"ok\":%s,\"pbo_requested_env\":%d,\"pbo_state\":%d,\"pbo_reason\":\"%s\",\"pbo_verified\":%s,"
             "\"cases\":%d,\"texels\":%d,\"on_vs_off_rgba\":%d,\"on_vs_off_raw\":%d,\"off_vs_model_rgba\":%d,"
             "\"off_vs_model_raw\":%d,\"on_vs_model_rgba\":%d,\"on_vs_model_raw\":%d,\"holes_changed\":%d,"
             "\"first_mismatch_index\":%d,\"preexisting_errors\":%d,\"last_preexisting\":%u,\"gl_error_test\":%u,"
             "\"gl_error_restore\":%u,\"state_restored\":%s,\"restore_mismatch_mask\":%u,\"live_vram_touched\":false",
             ok ? "true" : "false", gl_renderer_native_upload_pbo_requested(), s_nu_pbo_state, s_nu_pbo_reason,
             (ok && pbo_ready) ? "true" : "false", NCASE, TW * TH, onoff_rgba, onoff_raw, off_rgba, off_raw,
             on_rgba, on_raw, holes, first, pre_errors, (unsigned)last_pre, (unsigned)err_test,
             (unsigned)err_restore, state_restored ? "true" : "false", restore_mismatch);
    return ok;
}
static int make_fbo(GLuint *out_fbo, GLuint color_tex, GLuint stencil_rb) {
    p_glGenFramebuffers(1, out_fbo);
    p_glBindFramebuffer(0x8D40, *out_fbo);
    p_glFramebufferTexture2D(0x8D40, 0x8CE0, 0x0DE1, color_tex, 0);
    if (stencil_rb)
        p_glFramebufferRenderbuffer(0x8D40, 0x821A,
                                    0x8D41, stencil_rb);
    GLenum st = p_glCheckFramebufferStatus(0x8D40);
    p_glBindFramebuffer(0x8D40, 0);
    if (st != 0x8CD5) {
        fprintf((__acrt_iob_func(1)), "psxrecomp: GL FBO incomplete (0x%X)\n", st);
        return 0;
    }
    return 1;
}
