void gl_renderer_threat_draw_get(ThreatDrawState *out){
    memset(out,0,sizeof(*out));out->enabled=player_draw_enabled()&&threat_draw_enabled();
    if(!out->enabled)return;
    *out=s_threat_draw_completed;out->enabled=1;
    out->age_frames=s_frame_count>=out->frame?s_frame_count-out->frame:0xffffffffffffffffULL;
    if(out->age_frames>12){out->valid=0;out->count=0;}
}
static void hd_proof_draw_receipt(const HdTextureSourceMatch *m,
                                  const HdTextureDrawQuery *q,
                                  const HdTexturePixels *px, int semi,
                                  const int *xs, const int *ys,
                                  const int *us, const int *vs) {
    if(!px)player_draw_on_source(m,q,xs,ys);
    hd_research_on_draw(m,q,px,semi,xs,ys,us,vs);
    static int initialized = 0;
    static FILE *log = ((void*)0);
    static struct { uint32_t th, ph; int semi, replacement; } seen[4096];
    static unsigned nseen = 0;
