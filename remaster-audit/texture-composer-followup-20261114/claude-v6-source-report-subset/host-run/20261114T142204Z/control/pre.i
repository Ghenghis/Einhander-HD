    p_glAttachShader(p, v); p_glAttachShader(p, f);
    if (dual_source) {
        p_glBindFragDataLocationIndexed(p, 0, 0, "frag");
        p_glBindFragDataLocationIndexed(p, 0, 1, "blend_factor");
    }
    p_glLinkProgram(p);
    p_glDeleteShader(v); p_glDeleteShader(f);
    GLint ok = 0; p_glGetProgramiv(p, 0x8B82, &ok);
    if (!ok) { char log[1024]; log[0]=0; p_glGetProgramInfoLog(p, sizeof log, ((void*)0), log);
        fprintf((__acrt_iob_func(1)), "psxrecomp: GL program link failed: %s\n", log); return 0; }
    return p;
}
static GLuint build_program(const char *vs, const char *fs) {
