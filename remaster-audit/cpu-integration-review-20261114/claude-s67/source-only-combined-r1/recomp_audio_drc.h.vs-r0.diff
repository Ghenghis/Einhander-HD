     out->gap_epoch = b->gap_epoch;
+    out->gap_epoch_base_underruns = b->gap_epoch_base_underruns;
 }
 void rab_reset_gap_stats(rab_bridge *b) {
     memset(&b->gap, 0, sizeof(b->gap));
     b->in_gap = 0;
     b->gap_epoch++;
+    b->gap_epoch_base_underruns = b->stats.underrun_events;
