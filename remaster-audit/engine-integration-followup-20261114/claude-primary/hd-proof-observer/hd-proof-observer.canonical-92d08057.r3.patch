+/* HD-PROOF-OBSERVER BEGIN (r3) */
+/* Proof observer (PSXRECOMP_HD_PROOF_LOG). hd_proof_observer_on() is the only
+ * place the log is opened. It runs once, from whichever of the first receipt,
+ * the first control read or the first HD uniform setup comes first, so no gate
+ * can be set before the observer exists. With the variable unset, its first
+ * call does one getenv and one write (s_hd_proof_init_done = 1), then it
+ * returns 0 forever: the draw path does no proof I/O and no per-draw proof-state
+ * writes beyond the pre-existing s_hd_proof_counts.
+ *
+ * Two states: s_hd_proof_log_on ("observing": gate capture and per-draw counts,
+ * reported in .stats.json) and s_hd_proof_file (the receipt log). Reaching a cap
+ * writes the reserved final marker and closes the log; observing continues ONLY
+ * if that close succeeded. Any write, flush or close failure, an unknown start
+ * offset or a failed open stops observing: no further receipt I/O happens in
+ * this process. receipt_stop_reason keeps the FIRST reason; close failures are
+ * also counted on their own (receipt_close_errors). */
+/* HD-PROOF-IO BEGIN (r3): self-contained; needs only <stdio.h>, <stdint.h>,
+ * <stdlib.h> (getenv) and a uint64_t s_frame_count, so a CPU fixture can
+ * compile these exact bytes with shimmed stdio. */
+#define HD_PROOF_SEEN_MAX 4096u
+#define HD_PROOF_MAX_LINES 32768u                /* hard, includes the final marker */
+#define HD_PROOF_MAX_BYTES (16u * 1024u * 1024u) /* hard, bytes THIS process appends */
+#define HD_PROOF_LINE_MAX 2048
+#define HD_PROOF_EPOCH_MAX 255u
+#define HD_PROOF_MARKER "{\"event\":\"proof log capped\"}\n"
+#define HD_PROOF_MARKER_BYTES (sizeof HD_PROOF_MARKER - 1u)
+/* receipt_stop_reason in .stats.json: why the receipt log is not (or no longer) written. */
+enum { HD_PROOF_OPEN_OK, HD_PROOF_OPEN_FAILED, HD_PROOF_OFFSET_UNKNOWN, HD_PROOF_WRITE_FAILED,
+       HD_PROOF_CLOSE_FAILED };
+static FILE *s_hd_proof_file;
+static int s_hd_proof_init_done, s_hd_proof_log_on, s_hd_proof_capped, s_hd_proof_open_error;
+static long s_hd_proof_start_offset = -1;   /* file size before this process appended */
+static uint64_t s_hd_proof_bytes, s_hd_proof_write_errors, s_hd_proof_dropped_lines;
+static uint64_t s_hd_proof_close_errors;
+static unsigned s_hd_proof_epoch;        /* from PSXRECOMP_HD_PROOF_CONTROL, only while observing */
+static unsigned s_hd_proof_seen_epoch;   /* epoch the receipts and gate counts belong to */
+static unsigned s_hd_proof_lines;
+
+/* Stop observing for the run; the first reason wins. */
+static void hd_proof_stop(int reason) {
+    if (!s_hd_proof_open_error) s_hd_proof_open_error = reason;
+    s_hd_proof_log_on = 0;
+}
+
+/* The one place the receipt FILE is closed. The FILE is NULL after the first
+ * call whatever fclose returns, so it is never closed twice. A failing fclose
+ * (buffered bytes may be lost) is a close error and stops observing; it calls
+ * no other closer, so there is no recursion. */
+static void hd_proof_close_log(void) {
+    FILE *file = s_hd_proof_file;
+    if (!file) return;
+    s_hd_proof_file = NULL;
+    if (fclose(file) != 0) {
+        ++s_hd_proof_close_errors;
+        hd_proof_stop(HD_PROOF_CLOSE_FAILED);
+    }
+}
+
+/* Write failure: count it, stop observing (reason kept if earlier), close once. */
+static void hd_proof_fail(int reason) {
+    ++s_hd_proof_write_errors;
+    hd_proof_stop(reason);
+    hd_proof_close_log();
+}
+
+/* Writes n bytes as one line. Bytes count what fwrite actually accepted, even
+ * on a partial write; the line counts only when the whole line and the flush
+ * succeeded. */
+static int hd_proof_write_raw(const char *p, size_t n) {
+    const size_t wrote = fwrite(p,1,n,s_hd_proof_file);
+    s_hd_proof_bytes += (uint64_t)wrote;
+    if (wrote != n || fflush(s_hd_proof_file) != 0) { hd_proof_fail(HD_PROOF_WRITE_FAILED); return 0; }
+    ++s_hd_proof_lines;
+    return 1;
+}
+
+/* Appends one complete, already formatted line. The final marker's line and
+ * HD_PROOF_MARKER_BYTES are reserved from both hard caps, so a normal line is
+ * refused one line and one marker early; the marker is then written inside the
+ * caps and the log is closed (observing and counting continue). An over-long
+ * or failed format is dropped and counted, never split or truncated. */
+static void hd_proof_put(const char *line, int n) {
+    if (!s_hd_proof_file) return;
+    if (n <= 0 || n >= HD_PROOF_LINE_MAX) { ++s_hd_proof_dropped_lines; return; }
+    if (s_hd_proof_lines + 2u > HD_PROOF_MAX_LINES ||
+        s_hd_proof_bytes + (uint64_t)n + HD_PROOF_MARKER_BYTES > HD_PROOF_MAX_BYTES) {
+        s_hd_proof_capped = 1;
+        if (hd_proof_write_raw(HD_PROOF_MARKER,HD_PROOF_MARKER_BYTES)) hd_proof_close_log();
+        return;
+    }
+    hd_proof_write_raw(line,(size_t)n);
+}
+
+static int hd_proof_observer_on(void) {
+    if (!s_hd_proof_init_done) {
+        const char *path = getenv("PSXRECOMP_HD_PROOF_LOG");
+        s_hd_proof_init_done = 1;
+        if (path && *path) {
+            s_hd_proof_file = fopen(path, "ab");
+            if (!s_hd_proof_file) hd_proof_stop(HD_PROOF_OPEN_FAILED);
+        }
+        if (s_hd_proof_file) {
+            /* Never append at an unknown offset: a failed seek/tell (including a
+             * Windows 32-bit long overflow past 2 GiB, where ftell returns -1)
+             * fails closed before anything is written. Reason 2 is recorded
+             * before the close, so a failing close keeps reason 2 and only
+             * adds a close error. */
+            long offset = -1;
+            if (fseek(s_hd_proof_file,0,SEEK_END) == 0) offset = ftell(s_hd_proof_file);
+            if (offset < 0) {
+                hd_proof_stop(HD_PROOF_OFFSET_UNKNOWN);
+                hd_proof_close_log();
+            } else {
+                s_hd_proof_start_offset = offset;
+                s_hd_proof_log_on = 1;
+                s_hd_proof_seen_epoch = s_hd_proof_epoch;
+                char line[256];
+                const int n = snprintf(line,sizeof line,"{\"event\":\"proof log opened\",\"schema\":\"hd-proof-receipt-v5\","
+                    "\"frame\":%llu,\"epoch\":%u,\"start_offset\":%ld,\"max_bytes\":%u,\"max_lines\":%u}\n",
+                    (unsigned long long)s_frame_count,s_hd_proof_seen_epoch,s_hd_proof_start_offset,
+                    HD_PROOF_MAX_BYTES,HD_PROOF_MAX_LINES);
+                hd_proof_put(line,n);
+            }
+        }
+    }
+    return s_hd_proof_log_on;
+}
+/* HD-PROOF-IO END (r3) */
