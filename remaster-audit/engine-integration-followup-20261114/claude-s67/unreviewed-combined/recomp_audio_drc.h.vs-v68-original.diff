+/* Gap accounting (s67 proposal; counters only, never changes rendered PCM).
+ * A gap is one maximal run of starved OUTPUT frames counted by the same
+ * condition as underrun_events (primed && source not available), so
+ * sum over gaps of their lengths == underrun_events since the last reset.
+ * Pre-prime starvation is not a gap. A gap may span many rab_pull calls.
+ * Kept separate from rab_stats so rab_stats' layout (ABI) is unchanged. */
+typedef struct {
+    uint64_t gaps;              /* have -> starved transitions after priming  */
+    uint64_t max_gap_frames;    /* longest gap since init / last reset        */
+    uint64_t cur_gap_frames;    /* frames of the gap in progress, 0 if none   */
+} rab_gap_stats;
+
