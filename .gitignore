# Source-first workspace snapshot. Unlisted roots/files stay local.
/*
!/.gitignore
!/README.md
!/windows-x64/
!/macos-arm64/
!/remaster-audit/
!/tools/
!/CLAUDE.md
!/Claude-Einhander.cmd
!/coordination/
/coordination/*
!/coordination/DEVIN-HANDOFF.md
!/coordination/CLAUDE-HANDOFF.md
!/coordination/CLAUDE-WORK-QUEUE.md
!/coordination/work-continuity.json
!/.claude/
/.claude/*
!/.claude/settings.json

# Both platform trees contain local changes; retain their source separately.
/windows-x64/*
/macos-arm64/*
!/windows-x64/CMakeLists.txt
!/macos-arm64/CMakeLists.txt
!/windows-x64/codegen_setup.c
!/windows-x64/codegen_setup.h
!/macos-arm64/codegen_setup.c
!/macos-arm64/codegen_setup.h
!/windows-x64/catalog_identity.json
!/macos-arm64/catalog_identity.json
!/windows-x64/README.md
!/macos-arm64/README.md
!/windows-x64/VERSION
!/macos-arm64/VERSION
!/windows-x64/seeds/
!/macos-arm64/seeds/
!/windows-x64/psxrecomp/
!/macos-arm64/psxrecomp/
!/windows-x64/recomp-ui/
!/macos-arm64/recomp-ui/
!/windows-x64/tools/
!/windows-x64/docs/

# Include source snapshots and their own upstream ignore rules/notices.
# These are inline trees, not restored Git submodule histories.
/windows-x64/seeds/*
/macos-arm64/seeds/*
!/windows-x64/seeds/*.txt
!/macos-arm64/seeds/*.txt

# Developer tools: source and curated semantic catalogs, never live state.
/windows-x64/tools/*
!/windows-x64/tools/*.py
!/windows-x64/tools/*.js
!/windows-x64/tools/*.html
!/windows-x64/tools/*.css
!/windows-x64/tools/*.ps1
!/windows-x64/tools/*_catalog.json
!/windows-x64/tools/material-shader-kernels.json
!/windows-x64/tools/stage1_finish_plan.json
/windows-x64/docs/*
!/windows-x64/docs/*.md
!/windows-x64/docs/*.html

# Reproducible remaster scripts/plans and ComfyUI API graphs.
# Evidence, extracted native content, candidate packs and artwork stay local.
/remaster-audit/*
!/remaster-audit/*.py
!/remaster-audit/*.c
!/remaster-audit/*.cpp
!/remaster-audit/REMASTER_COMPLETION_PLAN.md
!/remaster-audit/TYPOGRAPHY_REPAIR_PLAN.md
!/remaster-audit/workflows/
/remaster-audit/workflows/*
!/remaster-audit/workflows/*.api.json
/tools/*
!/tools/coordination/
/tools/coordination/*
!/tools/coordination/*.mjs

# Local orchestration/configuration and credentials (at every depth).
.git/
.codex/
.hermes3d_orchestrator/
.playwright-mcp/
.mcp.json
.env
.env.*
.psxrecomp.env
.psxrecomp.env.*
*.pem
*.key
*.pfx
*.p12
*.credential*
settings.toml
settings.ini
keybinds.ini
input.ini
bios.cfg
disc.cfg
rom.cfg
material-selection.json
material-runtime.json
research-arm.json
research-index.json
research-session-summary.json
project_studio_repos.json

# Local game configuration contains machine-specific disc paths.
/windows-x64/game.toml
/macos-arm64/game.toml
/windows-x64/game_options.toml
/macos-arm64/game_options.toml

# Never traverse workspace dumps, user data or bulky generated trees.
**/build/
**/build-*/
**/out/
**/dist/
**/release-stage/
**/generated/
**/cache/
**/saves/
**/disc/
**/isos/
**/prepared_disc/
**/hd-textures/
**/hd_dump_rgba/
**/skin-workspace/
**/research-runs/
**/skin_collection/
**/material-profiles/
**/models/
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
**/.vs/
**/.vscode/
**/probes/
**/_wip/
**/.happypath/

# Binary/disc/memory/debug output. OpenBIOS's upstream allowlist and notice
# remain in each psxrecomp/.gitignore; no retail BIOS exception is added.
*.bin
*.BIN
*.cue
*.iso
*.img
*.sub
*.ccd
*.chd
*.rom
*.car
*.mcd
*.mcr
*.mcd.*
*.mcr.*
*.hex
*.i64
*.id0
*.id1
*.exe
*.dll
*.dylib
*.so
*.o
*.obj
*.pdb
*.ilk
*.a
*.lib
*.elf
*.eln
*.ko
*.rpx
*.lst
*.readelf
*.ips
*.zip
*.7z
*.tar.gz
*.tar.xz
*.gguf
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.log
*.jsonl
*.pyc
*.bak
*.tmp
CMakeCache.txt
CMakeFiles/
compile_commands.json
cmake_install.cmake
*.ninja
.ninja_log
.ninja_deps

# Keep vendor source archives through their nested pinned allowlist only.
# Game screenshots, extracted/native artwork and media are not source inputs.
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tga
*.tif
*.tiff
*.webp
*.mp4
*.avi
*.wav
*.mp3
*.pdf
*.docx
*.eot
*.woff
*.woff2
**/tools/aot_overlay_spike/*.json
**/tools/_*.json
# Vendored ELFIO executable samples are optional test data, not build source.
**/recompiler/lib/ELFIO/tests/elf_examples/

# Source directories may carry template examples and required vendor notices.
# Existing deeper .gitignore files still govern their own source/fixtures.

# Public documentation and deliberately curated gallery copies only.
# Source captures, replacement packs and generated artwork elsewhere stay local.
!/docs/
/docs/*
!/docs/*.md
!/docs/MASTER-ACTION-PLAN.html
!/docs/handbook/
/docs/handbook/*
!/docs/handbook/*.html
!/docs/handbook/*.css
!/docs/handbook/source-inventory.json
!/docs/media/
/docs/media/*
!/docs/media/gallery/
/docs/media/gallery/*
!/docs/media/gallery/*.png
!/docs/media/gallery/*.jpg
!/docs/media/gallery/*.jpeg
!/docs/media/gallery/*.webp
!/docs/media/gallery/*.json
!/docs/media/gallery/*.md
!/docs/media/gallery/h24-fly-past-entry.mp4
!/docs/media/gallery/h24-fly-past-middle.mp4
